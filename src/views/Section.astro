---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { SECTIONS, t, type Lang, type SectionKey } from '../config';
import { getArticles, localePath } from '../utils';

interface Props {
  lang: Lang;
  section: SectionKey;
}
const { lang, section } = Astro.props;
const s = t[lang];
const sec = SECTIONS[section];
const articles = (await getArticles(lang)).filter((a) => a.data.section === section);
const other = lang === 'uk' ? 'en' : 'uk';
---

<Base lang={lang} title={sec[lang].title} description={sec[lang].desc} altLangHref={localePath(other, `sections/${section}/`)}>
  <div class="container page">
    <nav aria-label={s.article.crumbs} class="crumbs">
      <a href={`${localePath(lang)}#sections`}>{s.sections.back}</a>
    </nav>
    <p class="mono num">{sec.num}</p>
    <h1 class="h-page">{sec[lang].title}</h1>
    <p class="lead-muted">{sec[lang].desc}</p>
    <p class="subs">{s.sections.includes} {sec[lang].subs.join(' · ')}</p>

    {
      articles.length ? (
        <ul class="list">
          {articles.map((a) => (
            <li>
              <ArticleCard article={a} lang={lang} headingLevel="h2" />
            </li>
          ))}
        </ul>
      ) : (
        <div class="empty card">
          <p>{s.sections.empty}</p>
          {s.sections.emptyOther && (
            <a class="text-link" href={localePath('uk', `sections/${section}/`)} hreflang="uk">
              {s.sections.emptyOther}
            </a>
          )}
        </div>
      )
    }
  </div>
</Base>

<style>
  .page {
    padding-block: 40px 80px;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: var(--muted);
  }
  .num {
    margin: 16px 0 8px;
    font-size: 14px;
    color: var(--accent);
  }
  .h-page {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .subs {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--text-2);
  }
  .list {
    list-style: none;
    margin: 36px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 20px;
  }
  .empty {
    margin-top: 36px;
    padding: 28px;
  }
  .empty p {
    margin: 0;
    color: var(--text-2);
  }
</style>
