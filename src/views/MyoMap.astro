---
// Інтерактивний довідник «Анатомічні орієнтири для міотестингу».
// Тексти, джерела й приклади систем — у src/data/myomap.json (редагуються без коду).
// Геометрія схем — нижче, у LAYOUT. Схеми оригінальні й умовні (не в масштабі).
import Base from '../layouts/Base.astro';
import { SITE, type Lang } from '../config';
import { localePath } from '../utils';
import data from '../data/myomap.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';
const author = SITE.author[lang];

type L10n = { uk: string; en: string };
const tx = (v: L10n | undefined) => (v ? v[lang] : '');

const ui = {
