// ---------- Геометрія ----------
type Ell = { cx: number; cy: number; rx: number; ry: number; rot?: number };
type Shape = { d: string } | Ell;
type Geo = { shapes: Shape[]; label?: [number, number] };
type Frame = { cx: number; cy: number; rx: number; ry: number };

const R = (n: number) => Math.round(n * 10) / 10;
const pt = (F: Frame, a: number, r: number): [number, number] => {
  const t = (a * Math.PI) / 180;
  return [F.cx + F.rx * r * Math.cos(t), F.cy - F.ry * r * Math.sin(t)];
};
// Кільцевий сектор еліпса: кут 90° — верх схеми, 180° — лівий бік.
const sector = (F: Frame, a0: number, a1: number, r0 = 0.6, r1 = 0.94): Geo => {
  const [x0, y0] = pt(F, a0, r1);
  const [x1, y1] = pt(F, a1, r1);
  const [x2, y2] = pt(F, a1, r0);
  const [x3, y3] = pt(F, a0, r0);
  const large = a1 - a0 > 180 ? 1 : 0;
  const d = `M${R(x0)} ${R(y0)}A${R(F.rx * r1)} ${R(F.ry * r1)} 0 ${large} 0 ${R(x1)} ${R(y1)}L${R(x2)} ${R(y2)}A${R(F.rx * r0)} ${R(F.ry * r0)} 0 ${large} 1 ${R(x3)} ${R(y3)}Z`;
  const [lx, ly] = pt(F, (a0 + a1) / 2, (r0 + r1) / 2);
  return { shapes: [{ d }], label: [R(lx), R(ly)] };
};
const e = (cx: number, cy: number, rx: number, ry: number, rot = 0): Ell => ({ cx, cy, rx, ry, rot });

const TR: Frame = { cx: 200, cy: 168, rx: 150, ry: 112 };
const TH: Frame = { cx: 200, cy: 168, rx: 126, ry: 118 };
const PH: Frame = { cx: 200, cy: 168, rx: 168, ry: 72 };

type Layout = {
  frame?: Frame;
  ring?: boolean;
  outline: string;
  under?: string; // декоративні елементи під м'язами
  over?: string; // кістки та інше поверх м'язів (без кліків)
  geo: Record<string, Geo>;
};

const LAYOUT: Record<string, Layout> = {
