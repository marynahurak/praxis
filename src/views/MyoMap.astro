<script>
  const root = document.querySelector<HTMLElement>('.mm');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const modeBtns = [...root.querySelectorAll<HTMLButtonElement>('[data-mode]')].filter((b) => b.tagName === 'BUTTON');
    const panels = [...root.querySelectorAll<HTMLElement>('.panel')];

    const select = (panel: HTMLElement, id: string | null) => {
      const ov = panel.querySelector('.sel-ov');
      ov?.replaceChildren();
      panel.querySelectorAll<SVGGElement>('.m').forEach((g) => {
        const on = g.dataset.m === id;
        g.classList.toggle('sel', on);
        g.setAttribute('aria-pressed', on ? 'true' : 'false');
        if (on && ov) g.querySelectorAll('.shape').forEach((sh) => ov.appendChild(sh.cloneNode(true)));
      });
      panel.querySelectorAll<HTMLElement>('.card-m').forEach((c) => (c.hidden = c.dataset.m !== id));
      const intro = panel.querySelector<HTMLElement>('.card-intro');
      if (intro) intro.hidden = !!id;
    };

    const setLevel = (id: string, updateHash = true) => {
      if (!panels.some((p) => p.dataset.level === id)) return;
      root.dataset.level = id;
      tabs.forEach((t) => t.setAttribute('aria-selected', t.dataset.level === id ? 'true' : 'false'));
      panels.forEach((p) => (p.hidden = p.dataset.level !== id));
      if (updateHash) history.replaceState(null, '', `#${id}`);
    };

    const setMode = (m: string) => {
      root.dataset.mode = m;
      modeBtns.forEach((b) => b.setAttribute('aria-pressed', b.dataset.mode === m ? 'true' : 'false'));
    };

    tabs.forEach((t) => t.addEventListener('click', () => setLevel(t.dataset.level!)));
    tabs.forEach((t, i) =>
      t.addEventListener('keydown', (ev) => {
        if (ev.key !== 'ArrowRight' && ev.key !== 'ArrowLeft') return;
        const next = tabs[(i + (ev.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        setLevel(next.dataset.level!);
      }),
    );
    modeBtns.forEach((b) => b.addEventListener('click', () => setMode(b.dataset.mode!)));

    panels.forEach((panel) => {
      panel.querySelectorAll<SVGGElement>('.m').forEach((g) => {
        const act = () => select(panel, g.classList.contains('sel') ? null : g.dataset.m!);
        g.addEventListener('click', act);
        g.addEventListener('keydown', (ev) => {
          if (ev.key === 'Enter' || ev.key === ' ') {
            ev.preventDefault();
            act();
          }
        });
      });
      panel.querySelectorAll('.back').forEach((b) => b.addEventListener('click', () => select(panel, null)));
      panel.querySelector('.go-tr')?.addEventListener('click', () => {
        setLevel('tr');
        document.getElementById('tab-tr')?.focus();
      });
    });

    const fromHash = () => {
      const h = location.hash.replace('#', '');
      if (h) setLevel(h, false);
    };
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>

