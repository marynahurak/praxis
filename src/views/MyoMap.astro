---
// «Атлас локалізації міоточок та конфігурації sEMG-електродів» — сторінка-довідник:
// призначення, методологія, зони слабкого сигналу, енергоефективність, симулятор, джерела.
// Сама інтерактивна мапа — на окремій повноекранній сторінці (src/views/MyoAtlas.astro, …/atlas/).
import Base from '../layouts/Base.astro';
import { type Lang } from '../config';
import { localePath, url } from '../utils';
import { D, LEVELS, MODES, VIEW_SHORT, SEC_SHORT_L, tr, getUi, simData, fmtUpdated } from '../lib/myomap';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';
const tx = tr(lang);
const ui = getUi(lang);
const atlasHref = localePath(lang, 'tools/myotesting-map/atlas/');
const fmtDate = fmtUpdated(lang);
const quick = LEVELS.map((lv) => ({
  lv,
  title: tx(D.levels[lv].title),
  links: [
    ...D.levels[lv].views.map((v: any) => ({ id: v.id, label: VIEW_SHORT[v.id][lang], title: tx(v.label) })),
    ...D.levels[lv].sections.map((s: any) => ({ id: s.id, label: `${SEC_SHORT_L[lang]}: ${tx(s.label).toLowerCase()}`, title: `${ui.section}: ${tx(s.label)}` })),
  ],
}));
---

<Base lang={lang} title={ui.title} description={ui.lead} altLangHref={localePath(other, 'tools/myotesting-map/')}>
  <script is:inline define:vars={{ atlasHref }}>
    // Старі посилання на конкретний вигляд (#tr_post/ed, #th…) ведуть на нову сторінку мапи.
    if (/^#(ph|tr|th|sd)(_[a-z0-9]+)?(\/[a-z_]+)?$/.test(location.hash)) location.replace(atlasHref + location.hash);
  </script>
  <script type="application/json" id="mm-sim-data" set:html={JSON.stringify(simData(lang))} />
  <div class="container page" data-pagefind-body>
    <nav class="crumbs" aria-label={ui.crumbs}><a href={localePath(lang, 'tools/')}>← {ui.crumbs}</a></nav>
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 class="h-page">{ui.title}</h1>
    <p class="lead-muted">{ui.lead}</p>
    <div class="meta-row">
      <span class="badge-ev"><span class="dot" aria-hidden="true"></span>{ui.evidenceBadge}</span>
      <span class="mono small">{ui.version} {D.meta.version} · {ui.updated} {fmtDate}</span>
    </div>

    <section class="cta" aria-labelledby="cta-h">
      <a class="cta-img" href={atlasHref} tabindex="-1" aria-hidden="true"><img src={url(`myomap/preview-${lang}.webp`)} width="1200" height="750" alt="" loading="eager" /></a>
      <div class="cta-body">
        <h2 id="cta-h" class="cta-h"><a href={atlasHref}>{ui.openAtlas} →</a></h2>
        <p class="cta-note">{ui.openAtlasNote}</p>
        <p class="ctl-label">{ui.quickTitle}</p>
        <dl class="quick">
          {quick.map((q) => (
            <>
              <dt>{q.title}</dt>
              <dd>{q.links.map((l: any) => <a class="chip-link" href={`${atlasHref}#${l.id}`} title={l.title}>{l.label}</a>)}</dd>
            </>
          ))}
        </dl>
      </div>
    </section>

    <section class="scope" id="scope" aria-labelledby="scope-h">
      <h2 id="scope-h" class="scope-h">{ui.scopeTitle}</h2>
      <p>{ui.scope}</p>
    </section>
    <aside class="warn" role="note"><strong>{ui.warnTitle}.</strong>{' '}{ui.warn}</aside>

    <section class="block" id="how">
      <h2 class="h-sub">{ui.howTitle}</h2>
      <ol class="how-list">{ui.how.map((h: string) => <li>{h}</li>)}</ol>
    </section>

    <section class="block" id="modes">
      <h2 class="h-sub">{ui.modesTitle}</h2>
      <ul class="tiles">{MODES.map((m) => <li><h3>{tx(D.modes[m].label)}</h3><p>{tx(D.modes[m].desc)}</p></li>)}</ul>
    </section>

    <section class="block" id="weak">
      <h2 class="h-sub">{ui.weakTitle}</h2>
      <ul class="tiles">
        {D.weak.map((w: any) => <li><h3>{tx(w.title)} <span class={`basis basis-${w.basis}`}>{(ui.basis as any)[w.basis]}</span></h3><p>{tx(w.text)}</p></li>)}
      </ul>
    </section>

    <section class="block" id="effort">
      <h2 class="h-sub">{ui.effortTitle}</h2>
      <p class="block-lead">{tx(D.effort.intro)}</p>
      <ul class="principles">
        {D.effort.principles.map((p: any) => <li><span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span> {tx(p.text)}</li>)}
      </ul>
      <p class="eff-legend">{['low', 'moderate', 'high'].map((k) => <span class={`eff eff-${k}`}>{tx(D.effort.levels[k])}</span>)}</p>
      <p class="small muted">{tx(D.effort.note)}</p>
    </section>

    <section class="block" id="how-it-works">
      <h2 class="h-sub">{ui.howWorksTitle}</h2>
      <ol class="steps">
        {D.how.map((s: any, i: number) => <li><span class="step-n">{i + 1}</span><div><h3>{tx(s.t)}</h3><p>{tx(s.x)}</p></div></li>)}
      </ol>
      <div class="sim card-x">
        <h3 class="sim-title">{ui.simTitle}</h3>
        <div class="sim-grid">
          <div class="sim-ctl">
            <label class="sl"><span>{ui.simOpen}</span><input type="range" min="0" max="100" value="0" data-sim="a" /></label>
            <label class="sl"><span>{ui.simClose}</span><input type="range" min="0" max="100" value="0" data-sim="b" /></label>
            <label class="sl"><span>{ui.simThr}</span><input type="range" min="5" max="60" value="25" data-sim="thr" /></label>
            <label class="ck"><input type="checkbox" data-sim="x" /> {ui.simCross}</label>
            <label class="ck"><input type="checkbox" data-sim="t" /> {ui.simTendon}</label>
            <p class="sim-state" aria-live="polite">{ui.simState.idle}</p>
          </div>
          <div class="sim-plot">
            <canvas class="sim-cv" width="720" height="320" role="img" aria-label={`${ui.simRaw}; ${ui.simEnv}`}></canvas>
            <p class="sim-legend"><span class="k1">■</span> {lang === 'uk' ? 'Канал 1' : 'Channel 1'} · <span class="k2">■</span> {lang === 'uk' ? 'Канал 2' : 'Channel 2'} · {ui.simRaw} / {ui.simEnv}</p>
          </div>
          <svg class="sim-hand" viewBox="0 0 120 140" aria-hidden="true">
            <g class="sh-f2"><rect x="58" y="14" width="13" height="72" rx="6.5" class="sh-fin" /><rect x="72" y="18" width="13" height="68" rx="6.5" class="sh-fin" /></g>
            <g class="sh-f1"><rect x="30" y="42" width="15" height="48" rx="7.5" class="sh-fin" /></g>
            <rect x="34" y="78" width="54" height="50" rx="12" class="sh-palm" />
          </svg>
        </div>
        <p class="small muted">{ui.simNote}</p>
      </div>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.pitfallsTitle}</h2>
      <ul class="tiles">{D.pitfalls.map((p: any) => <li><h3>{tx(p.title)} <span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span></h3><p>{tx(p.text)}</p></li>)}</ul>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.systemsTitle}</h2>
      <div class="systems">
        {['direct', 'pr'].map((m) => (
          <div>
            <h3 class="sys-h">{tx(D.modes[m].label)}</h3>
            <ul class="refs mfr">{D.systems[m].map((s: any) => <li><strong>{s.name}.</strong> {tx(s.note)} <a href={s.url} rel="noopener">{ui.source2}</a></li>)}</ul>
          </div>
        ))}
      </div>
      <p class="small muted">{ui.systemsNote}</p>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.evidenceTitle}</h2>
      <dl class="ev">{ui.evidenceRows.map(([k, v]) => <><dt>{k}</dt><dd>{v}</dd></>)}</dl>
    </section>

    <section class="block" id="anatomy-source">
      <h2 class="h-sub">{ui.sourceTitle}</h2>
      <p class="block-lead">{ui.source} <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener license">CC BY 4.0</a> · <a href={url('myomap/ATTRIBUTION-BodyParts3D.md')}>ATTRIBUTION</a></p>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.refsTitle}</h2>
      <ol class="refs">{D.references.map((r: any) => <li>{r.text} <a href={`https://doi.org/${r.doi}`} rel="noopener">doi:{r.doi}</a></li>)}</ol>
      <h3 class="cite-h">{ui.mfrTitle}</h3>
      <ul class="refs mfr">{D.electrodes.map((e: any) => <li><strong>{e.example}.</strong> {tx(e.note)} <a href={e.url} rel="noopener">{ui.source2}</a></li>)}</ul>
      <h3 class="cite-h">{ui.citeTitle}</h3>
      <p class="cite">{ui.cite} {ui.avail} {new URL(localePath(lang, 'tools/myotesting-map/'), Astro.site).href}</p>
      <p class="small muted">{ui.coi}</p>
    </section>
  </div>
</Base>

<script>
  import { initSim } from '../scripts/myomap-client';
  initSim();
</script>

<style>
  .page { padding-block: 32px 80px; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; color: var(--muted); }
  .h-page { margin: 6px 0 0; font-size: clamp(32px, 4vw, 46px); line-height: 1.1; letter-spacing: -0.02em; font-weight: 600; }
  .lead-muted { max-width: 820px; }
  .meta-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 18px; }
  .badge-ev { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: #fbf3e4; border: 1px solid #ecd6ad; color: #6b4a12; font-size: 14px; font-weight: 500; }
  .badge-ev .dot { width: 8px; height: 8px; border-radius: 50%; background: #c98a1b; }
  .mono { font-family: var(--font-mono); }
  .small { font-size: 13.5px; }
  .muted { color: var(--muted); }
  .ctl-label { margin: 0 0 6px; font: 500 11.5px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }

  .cta { margin-top: 26px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); align-items: stretch; background: var(--graphite-900); border-radius: var(--radius); overflow: hidden; max-width: 1120px; }
  @media (max-width: 860px) { .cta { grid-template-columns: minmax(0, 1fr); } }
  .cta-img { display: block; background: #eef1f6; }
  .cta-img img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .cta-body { padding: 24px 26px; color: var(--on-dark); }
  .cta-h { margin: 0 0 8px; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2; }
  .cta-h a { color: #fff; text-decoration: none; }
  .cta-h a:hover { color: var(--on-dark-accent); }
  .cta-note { margin: 0 0 18px; color: var(--on-dark-2); line-height: 1.55; }
  .cta .ctl-label { color: var(--on-dark-accent); }
  .quick { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 14px; margin: 0; align-items: baseline; }
  @media (max-width: 520px) { .quick { grid-template-columns: minmax(0, 1fr); gap: 4px; } .quick dd { margin-bottom: 8px !important; } }
  .quick dt { font-size: 14px; color: var(--on-dark); font-weight: 600; }
  .quick dd { margin: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip-link { display: inline-flex; align-items: center; min-height: 32px; padding: 4px 11px; border: 1px solid var(--dark-line); border-radius: 999px; color: var(--on-dark); font-size: 13px; text-decoration: none; }
  .chip-link:hover { border-color: var(--on-dark-accent); color: #fff; }

  .scope { margin-top: 26px; max-width: 900px; padding: 16px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); scroll-margin-top: 16px; }
  .scope-h { margin: 0 0 6px; font: 500 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
  .scope p { margin: 0; color: var(--text-2); line-height: 1.6; }
  .warn { margin-top: 14px; padding: 16px 18px; border-left: 4px solid #c98a1b; background: #fffaf1; border-radius: 0 var(--radius) var(--radius) 0; color: var(--ink-2); max-width: 900px; line-height: 1.55; }
  .how-list { margin: 0; padding-left: 22px; color: var(--text-2); line-height: 1.6; max-width: 900px; }
  .how-list li { margin-bottom: 6px; }
  .card-x { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px 18px; color: var(--text-2); line-height: 1.55; }
  .card-x p { margin: 0 0 9px; }
  .block { margin-top: 44px; max-width: 1040px; }
  .h-sub { margin: 0 0 12px; font-size: 26px; line-height: 1.25; color: var(--ink); }
  .block-lead { color: var(--text-2); line-height: 1.6; max-width: 880px; }
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 14px; }
  .tiles li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; color: var(--text-2); line-height: 1.55; }
  .tiles h3 { margin: 0 0 6px; font-size: 16px; color: var(--ink); }
  .tiles p { margin: 0; font-size: 14.5px; }
  .basis { display: inline-block; padding: 1px 8px; border-radius: 999px; font: 500 11.5px var(--font-mono); vertical-align: 2px; white-space: nowrap; }
  .basis-evidence { background: #e2f0e6; color: #1f5a32; } .basis-mechanistic { background: var(--chip); color: var(--text-2); } .basis-expert { background: #f6ecd3; color: #6b4a12; }
  .principles { padding-left: 0; list-style: none; display: flex; flex-direction: column; gap: 8px; color: var(--text-2); line-height: 1.55; max-width: 900px; }
  .eff-legend { display: flex; flex-wrap: wrap; gap: 6px; }
  .steps { list-style: none; padding: 0; margin: 0 0 18px; display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; }
  .steps li { display: flex; gap: 12px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; color: var(--text-2); line-height: 1.55; }
  .step-n { flex: 0 0 30px; height: 30px; border-radius: 50%; background: var(--graphite-900); color: #fff; display: inline-flex; align-items: center; justify-content: center; font: 600 14px var(--font-mono); }
  .steps h3 { margin: 2px 0 4px; font-size: 16px; color: var(--ink); }
  .steps p { margin: 0; font-size: 14.5px; }
  .sim-title { margin: 0 0 12px !important; font: 600 17px var(--font-sans) !important; text-transform: none !important; letter-spacing: 0 !important; color: var(--ink) !important; }
  .sim-grid { display: grid; grid-template-columns: minmax(200px, 0.8fr) minmax(0, 2fr) 110px; gap: 16px; align-items: center; }
  @media (max-width: 760px) { .sim-grid { grid-template-columns: minmax(0, 1fr) 90px; } .sim-plot { grid-column: 1 / -1; grid-row: 2; } }
  .sim-ctl { display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .sl { display: flex; flex-direction: column; gap: 4px; }
  .sl input { width: 100%; accent-color: var(--accent); min-height: 28px; }
  .ck { display: flex; align-items: center; gap: 6px; min-height: 30px; }
  .ck input { accent-color: var(--accent); width: 16px; height: 16px; }
  .sim-state { margin: 4px 0 0 !important; font-weight: 600; color: var(--ink); }
  .sim-cv { width: 100%; height: auto; display: block; background: #f8f9fb; border: 1px solid var(--line-2); border-radius: 8px; }
  .sim-legend { margin: 6px 0 0 !important; font-size: 12px; color: var(--muted); }
  .k1 { color: #2756b8; } .k2 { color: #c98a1b; }
  .sim-hand { width: 100%; height: auto; }
  .sh-palm { fill: #c9ced6; stroke: #3f4754; stroke-width: 2; }
  .sh-fin { fill: #dfe3e9; stroke: #3f4754; stroke-width: 2; }
  .systems { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 8px 24px; }
  .sys-h { margin: 0 0 6px; font-size: 16px; color: var(--ink); }
  .ev { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 8px 20px; margin: 0; color: var(--text-2); }
  .ev dt { font-weight: 600; color: var(--ink); }
  .ev dd { margin: 0; }
  @media (max-width: 640px) { .ev { grid-template-columns: minmax(0, 1fr); gap: 2px; } .ev dd { margin-bottom: 10px; } }
  .refs { padding-left: 22px; color: var(--text-2); font-size: 14.5px; line-height: 1.55; }
  .refs li { margin-bottom: 6px; overflow-wrap: anywhere; }
  .refs.mfr { list-style: disc; font-size: 13.5px; }
  .cite-h { margin: 16px 0 6px; font: 500 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .cite { font-size: 14.5px; color: var(--text-2); overflow-wrap: anywhere; }
</style>
