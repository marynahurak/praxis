            <div><dt>{ui.pass.purpose}</dt><dd>{ui.passPurpose}</dd></div>
            <div><dt>{ui.pass.evidence}</dt><dd>{ui.passEvidence}</dd></div>
            <div><dt>{ui.pass.repro}</dt><dd>{ui.passRepro} <a href={`${repo}/tree/main/scripts/myomap-pipeline`} rel="noopener">{ui.passLinks.pipeline}</a> · <a href={`${repo}/blob/main/docs/myomap-design-log.md`} rel="noopener">{ui.passLinks.log}</a> · <a href={`${repo}/commits/main`} rel="noopener">{ui.passLinks.history}</a></dd></div>
            <div><dt>{ui.pass.author}</dt><dd>{SITE.author[lang].name} · <a href={SITE.orcidUrl} rel="noopener">ORCID {SITE.orcid}</a></dd></div>
            <div><dt>{ui.pass.rights}</dt><dd>{ui.passRights} <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener">CC BY-NC-ND 4.0</a></dd></div>
            <div><dt>{ui.pass.cite}</dt><dd class="cite">{ui.citeDoc ? <>{ui.citeDoc} {ui.onlineAt} {pageUrl}</> : <>{ui.cite} {ui.avail} {pageUrl}</>}</dd></div>
          </dl>
          <div class="pass-side">
            <h3 class="sub-k">{ui.changelogTitle}</h3>
            <ol class="clog">
