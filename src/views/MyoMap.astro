---
// «Атлас локалізації міоточок та конфігурації sEMG-електродів» — сторінка-довідник:
// призначення, методологія, зони слабкого сигналу, енергоефективність, сигнальний ланцюг і симулятор, джерела.
// Сама інтерактивна мапа — на окремій повноекранній сторінці (src/views/MyoAtlas.astro, …/atlas/).
import Base from '../layouts/Base.astro';
import { type Lang } from '../config';
import { localePath, url } from '../utils';
import { D, LEVELS, MODES, VIEW_SHORT, SEC_SHORT_L, tr, getUi, simData, fmtUpdated } from '../lib/myomap';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';
const tx = tr(lang);
const ui = getUi(lang);
const atlasHref = localePath(lang, 'tools/myotesting-map/atlas/');
const fmtDate = fmtUpdated(lang);

const nViews = LEVELS.reduce((n, lv) => n + D.levels[lv].views.length, 0);
const nSections = LEVELS.reduce((n, lv) => n + D.levels[lv].sections.length, 0);
const stats = [
  [LEVELS.length, ui.statLevels], [nViews, ui.statViews], [nSections, ui.statSections],
  [Object.keys(D.muscles).length, ui.statMuscles], [D.electrodes.length, ui.statElectrodes], [D.references.length, ui.statRefs],
] as [number, string][];

const levelCards = LEVELS.map((lv) => ({
  lv,
  title: tx(D.levels[lv].title),
  img: url(`myomap/${D.levels[lv].views[0].id}.webp`),
  links: [
    ...D.levels[lv].views.map((v: any) => ({ id: v.id, label: VIEW_SHORT[v.id][lang], title: tx(v.label) })),
    ...D.levels[lv].sections.map((s: any) => ({ id: s.id, label: `${SEC_SHORT_L[lang]}: ${tx(s.label).toLowerCase()}`, title: `${ui.section}: ${tx(s.label)}` })),
  ],
}));

// ---- детерміновані «ЕМГ-подібні» криві для декоративних графіків (лише ілюстрація, не дані)
function rng(seed: number) {
  let s = seed >>> 0;
  return () => ((s = (Math.imul(s, 1664525) + 1013904223) >>> 0) / 4294967296);
}
const gauss = (x: number, c: number, w: number) => Math.exp(-((x - c) ** 2) / (2 * w * w));
function emg(seed: number, W: number, mid: number, amp: number, bursts: [number, number, number][], step = 2.2, floor = 0.05, repeat = 1) {
  const r = rng(seed);
  const ys: number[] = [];
  for (let x = 0; x <= W; x += step) {
    const env = floor + bursts.reduce((a, [c, w, h]) => a + h * gauss(x, c, w), 0);
    ys.push((r() * 2 - 1) * env * amp);
  }
  let d = '';
  for (let k = 0; k < repeat; k++) ys.forEach((y, i) => { d += `${d ? 'L' : 'M'}${(k * W + i * step).toFixed(1)} ${(mid + y).toFixed(1)}`; });
  return d;
}
const heroTraces = [
  { d: emg(7, 800, 60, 46, [[140, 40, 1], [470, 55, 0.8], [690, 30, 0.6]], 2.4, 0.05, 2), c: 't1' },
  { d: emg(19, 800, 60, 40, [[300, 50, 0.9], [600, 45, 1]], 2.4, 0.05, 2), c: 't2' },
];
// міні-графіки для сигнального ланцюга (160 × 56)
const W = 160;
const spikes = Array.from({ length: 9 }, (_, i) => 12 + i * 17 + (i % 3) * 3).map((x) => `M${x} 44V10`).join('');
const muap = emg(3, W, 28, 24, [[80, 34, 1]], 1.6, 0.06);
const noisy = (() => { const r = rng(11); let d = ''; for (let x = 0; x <= W; x += 1.6) d += `${d ? 'L' : 'M'}${x.toFixed(1)} ${(16 + Math.sin(x / 6) * 7 + (r() * 2 - 1) * 2).toFixed(1)}`; return d; })();
const clean = emg(5, W, 42, 12, [[80, 30, 1]], 1.6, 0.04);
const rect = (() => { const r = rng(23); let d = ''; for (let x = 0; x <= W; x += 1.6) { const e = 0.06 + gauss(x, 80, 30); d += `M${x.toFixed(1)} 48V${(48 - r() * e * 40).toFixed(1)}`; } return d; })();
const envl = (() => { let d = ''; for (let x = 0; x <= W; x += 4) d += `${d ? 'L' : 'M'}${x} ${(48 - (0.06 + gauss(x, 80, 30)) * 24).toFixed(1)}`; return d; })();
const ctrlEnv = (() => { let d = ''; for (let x = 0; x <= W; x += 4) d += `${d ? 'L' : 'M'}${x} ${(46 - (0.05 + gauss(x, 82, 26)) * 36).toFixed(1)}`; return d; })();
const minis = [
  `<path d="${spikes}" class="mw-a"/><path d="M0 44H160" class="mw-ax"/>`,
  `<path d="M0 28H160" class="mw-ax"/><path d="${muap}" class="mw-a"/>`,
  `<path d="${noisy}" class="mw-g"/><path d="${clean}" class="mw-a"/>`,
  `<path d="M0 48H160" class="mw-ax"/><path d="M8 48C30 48 36 14 52 12H120C134 14 140 48 156 48" class="mw-band"/><text x="52" y="9" class="mw-t">90</text><text x="112" y="9" class="mw-t">450 Hz</text>`,
  `<path d="${rect}" class="mw-g"/><path d="${envl}" class="mw-a"/>`,
  `<path d="${ctrlEnv}" class="mw-a"/><path d="M0 30H160" class="mw-thr"/><path d="M0 52H58V40H108V52H160" class="mw-b"/>`,
];

const STEP_ICONS = [
  '<rect x="6" y="8" width="36" height="32" rx="5"/><path d="M6 18h36M16 8v10M28 8v10"/>',
  '<circle cx="19" cy="19" r="12"/><circle cx="19" cy="19" r="4"/><path d="M27 27l15 6-6 2-2 6z"/>',
  '<rect x="8" y="14" width="32" height="20" rx="5"/><path d="M17 18v12M24 18v12M31 18v12"/>',
];
const MODE_ICONS: Record<string, string> = {
  direct: '<circle cx="40" cy="40" r="24"/><rect x="31" y="6" width="18" height="10" rx="3" class="ic-a"/><rect x="31" y="64" width="18" height="10" rx="3" class="ic-b"/><path d="M40 20v8M40 52v8"/>',
  pr: '<circle cx="40" cy="40" r="24"/>' + Array.from({ length: 8 }, (_, k) => { const a = (k * Math.PI) / 4; const x = 40 + 30 * Math.cos(a), y = 40 + 30 * Math.sin(a); return `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="4.5" class="ic-a"/>`; }).join('') + '<circle cx="40" cy="40" r="3" class="ic-f"/>',
  tmr: '<rect x="44" y="20" width="26" height="40" rx="6" class="ic-h"/><path d="M8 52c10 0 14-28 26-28h10" class="ic-n"/><circle cx="8" cy="52" r="3" class="ic-f"/>',
};
const WEAK_ICONS = [
  '<path d="M6 14c6-4 10 4 16 0s10 4 16 0M6 24c6-4 10 4 16 0s10 4 16 0M6 34c6-4 10 4 16 0s10 4 16 0"/>',
  '<path d="M12 10a5 5 0 1 0 2 8l12 12a5 5 0 1 0 8 2 5 5 0 1 0-2-8L20 12a5 5 0 1 0-8-2z"/>',
  '<circle cx="24" cy="24" r="4"/><path d="M18 24H6M30 24h12M10 20l-4 4 4 4M38 20l4 4-4 4"/>',
  '<path d="M6 12h36M6 20h36M6 28h36M6 36h36" /><circle cx="24" cy="36" r="3"/>',
  '<rect x="6" y="10" width="16" height="28" rx="3"/><rect x="26" y="10" width="16" height="28" rx="3"/><path d="M24 6v36" class="ic-d"/>',
  '<path d="M6 30l6-8 6 8 6-8 6 8 6-8 6 8"/>',
];
const sim = simData(lang);
const GRIPS = ['power', 'tripod', 'key', 'point'] as const;
---

<Base lang={lang} title={ui.title} description={ui.lead} altLangHref={localePath(other, 'tools/myotesting-map/')}>
  <script is:inline define:vars={{ atlasHref }}>
    // Старі посилання на конкретний вигляд (#tr_post/ed, #th…) ведуть на сторінку мапи.
    if (/^#(ph|tr|th|sd)(_[a-z0-9]+)?(\/[a-z_]+)?$/.test(location.hash)) location.replace(atlasHref + location.hash);
  </script>
  <script type="application/json" id="mm-sim-data" set:html={JSON.stringify(sim)} />

  <div data-pagefind-body>
    <!-- ============================================================ HERO -->
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-traces-wrap" aria-hidden="true">
        <svg class="hero-traces" viewBox="0 0 1600 120" preserveAspectRatio="none">
          {heroTraces.map((t) => <path d={t.d} class={t.c} />)}
        </svg>
      </div>
      <div class="container hero-in">
        <div class="hero-text">
          <nav class="crumbs" aria-label={ui.crumbs}><a href={localePath(lang, 'tools/')}>← {ui.crumbs}</a></nav>
          <p class="kicker">{ui.eyebrow}</p>
          <h1 class="hero-h">{ui.title}</h1>
          <p class="hero-lead">{ui.lead}</p>
          <div class="hero-cta">
            <a class="btn btn-primary btn-glow" href={atlasHref}>{ui.openAtlas} <span aria-hidden="true">→</span></a>
            <a class="btn btn-ghost" href="#chain">{ui.howWorksTitle} <span aria-hidden="true">↓</span></a>
          </div>
          <p class="hero-meta">
            <span class="pill pill-ev"><span class="dot" aria-hidden="true"></span>{ui.evidenceBadge}</span>
            <span class="pill">{ui.version} {D.meta.version} · {fmtDate}</span>
          </p>
        </div>
        <a class="hero-vis" href={atlasHref} aria-label={ui.openAtlas}>
          <span class="frame">
            <img src={url(`myomap/preview-${lang}.webp`)} width="1200" height="750" alt="" loading="eager" />
            <span class="crn tl" aria-hidden="true"></span><span class="crn tr" aria-hidden="true"></span><span class="crn bl" aria-hidden="true"></span><span class="crn br" aria-hidden="true"></span>
          </span>
          <span class="fig-cap">{ui.figCaption}</span>
        </a>
      </div>
      <div class="container">
        <ul class="stats">
          {stats.map(([n, l]) => <li><span class="stat-n">{String(n).padStart(2, '0')}</span><span class="stat-l">{l}</span></li>)}
        </ul>
      </div>
    </section>

    <!-- ============================================================ LEVELS -->
    <section class="band" id="levels">
      <div class="container">
        <header class="sec-h"><span class="sec-n">00</span><h2>{ui.levelsTitle}</h2></header>
        <p class="sec-lead">{ui.levelsLead}</p>
        <ul class="lv-grid">
          {levelCards.map((c) => (
            <li class="lv-card">
              <a class="lv-img" href={`${atlasHref}#${c.lv}`} tabindex="-1" aria-hidden="true"><img src={c.img} alt="" loading="lazy" /></a>
              <div class="lv-body">
                <h3><a href={`${atlasHref}#${c.lv}`}>{c.title}</a></h3>
                <p class="lv-links">{c.links.map((l: any) => <a class="chip-link" href={`${atlasHref}#${l.id}`} title={l.title}>{l.label}</a>)}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================================================ 01 SCOPE -->
    <section class="band band-alt" id="scope">
      <div class="container two">
        <div>
          <header class="sec-h"><span class="sec-n">01</span><span class="sec-k">{ui.sec.scope}</span></header>
          <h2 class="h2">{ui.scopeTitle}</h2>
        </div>
        <div>
          <p class="scope-p">{ui.scope}</p>
          <aside class="warn" role="note"><strong>{ui.warnTitle}.</strong>{' '}{ui.warn}</aside>
        </div>
      </div>
    </section>

    <!-- ============================================================ 02 HOW TO USE -->
    <section class="band" id="how">
      <div class="container">
        <header class="sec-h"><span class="sec-n">02</span><span class="sec-k">{ui.sec.how}</span></header>
        <h2 class="h2">{ui.howTitle}</h2>
        <ol class="steps3">
          {ui.how.map((h: string, i: number) => (
            <li>
              <span class="st-top"><span class="st-n">{String(i + 1).padStart(2, '0')}</span><svg class="st-ic" viewBox="0 0 48 48" aria-hidden="true" set:html={STEP_ICONS[i]} /></span>
              <p>{h}</p>
            </li>
          ))}
        </ol>
        <p class="center"><a class="btn btn-primary" href={atlasHref}>{ui.openAtlas} <span aria-hidden="true">→</span></a></p>
      </div>
    </section>

    <!-- ============================================================ 03 MODES -->
    <section class="band band-alt" id="modes">
      <div class="container">
        <header class="sec-h"><span class="sec-n">03</span><span class="sec-k">{ui.sec.modes}</span></header>
        <h2 class="h2">{ui.modesTitle}</h2>
        <ul class="cards3">
          {MODES.map((m) => (
            <li class="mode-card">
              <svg class="mode-ic" viewBox="0 0 80 80" aria-hidden="true" set:html={MODE_ICONS[m]} />
              <h3>{tx(D.modes[m].label)}</h3>
              <p>{tx(D.modes[m].desc)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================================================ 04 WEAK -->
    <section class="band" id="weak">
      <div class="container">
        <header class="sec-h"><span class="sec-n">04</span><span class="sec-k">{ui.sec.weak}</span></header>
        <h2 class="h2">{ui.weakTitle}</h2>
        <ul class="tiles">
          {D.weak.map((w: any, i: number) => (
            <li>
              <svg class="tile-ic" viewBox="0 0 48 48" aria-hidden="true" set:html={WEAK_ICONS[i] ?? ''} />
              <h3>{tx(w.title)}</h3>
              <p>{tx(w.text)}</p>
              <span class={`basis basis-${w.basis}`}>{(ui.basis as any)[w.basis]}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ============================================================ 05 EFFORT -->
    <section class="band band-alt" id="effort">
      <div class="container">
        <header class="sec-h"><span class="sec-n">05</span><span class="sec-k">{ui.sec.effort}</span></header>
        <h2 class="h2">{ui.effortTitle}</h2>
        <div class="effort-grid">
          <div>
            <p class="sec-lead">{tx(D.effort.intro)}</p>
            <ul class="principles">
              {D.effort.principles.map((p: any) => <li><span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span><span>{tx(p.text)}</span></li>)}
            </ul>
            <p class="eff-legend">{['low', 'moderate', 'high'].map((k) => <span class={`eff eff-${k}`}>{tx(D.effort.levels[k])}</span>)}</p>
            <p class="fine">{tx(D.effort.note)}</p>
          </div>
          <figure class="curve">
            <svg viewBox="0 0 360 250" role="img" aria-label={ui.curveTitle}>
              <defs>
                <linearGradient id="cz" x1="0" x2="1"><stop offset="0" stop-color="#2756b8" stop-opacity="0.18" /><stop offset="1" stop-color="#2756b8" stop-opacity="0.04" /></linearGradient>
              </defs>
              <rect x="52" y="20" width="92" height="190" fill="url(#cz)" />
              <path d="M52 210V20M52 210H340" class="cv-ax" />
              {[1, 2, 3, 4].map((i) => <path d={`M${52 + i * 72} 210V20`} class="cv-grid" />)}
              {[1, 2, 3].map((i) => <path d={`M52 ${210 - i * 47}H340`} class="cv-grid" />)}
              <path d="M62 26C80 120 120 170 170 186S280 200 336 203" class="cv-line" />
              <text x="98" y="202" class="cv-zone" text-anchor="middle">{ui.curveZone}</text>
              <text x="196" y="238" class="cv-lab" text-anchor="middle">{ui.curveX}</text>
              <text x="20" y="115" class="cv-lab" text-anchor="middle" transform="rotate(-90 20 115)">{ui.curveY}</text>
            </svg>
            <figcaption>{ui.curveNote}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============================================================ 06 SIGNAL CHAIN + SIMULATOR -->
    <section class="dark" id="chain">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container">
        <header class="sec-h on-dark"><span class="sec-n">06</span><span class="sec-k">{ui.sec.chain}</span></header>
        <h2 class="h2 on-dark">{ui.howWorksTitle}</h2>
        <p class="sec-lead on-dark">{ui.chainLead}</p>
        <ol class="chain">
          {D.how.map((s: any, i: number) => (
            <li>
              <span class="ch-n">{String(i + 1).padStart(2, '0')}</span>
              <svg class="mini" viewBox="0 0 160 56" aria-hidden="true" set:html={minis[i]} />
              <h3>{tx(s.t)}</h3>
              <p>{tx(s.x)}</p>
            </li>
          ))}
        </ol>

        <div class="sim" id="simulator">
          <div class="sim-head">
            <h3 class="sim-title">{ui.simTitle}</h3>
            <p class="sim-state" aria-live="polite">{ui.simState.idle}</p>
          </div>
          <div class="sim-grid">
            <div class="sim-ctl">
              <div class="sim-sliders">
              <label class="sl sl-1"><span>{ui.simOpen}</span><input type="range" min="0" max="100" value="0" data-sim="a" /></label>
              <label class="sl sl-2"><span>{ui.simClose}</span><input type="range" min="0" max="100" value="0" data-sim="b" /></label>
              <label class="sl sl-t"><span>{ui.simThr}</span><input type="range" min="5" max="60" value="25" data-sim="thr" /></label>
              </div>
              <div class="sim-opts">
              <label class="ck"><input type="checkbox" data-sim="x" /> {ui.simCross}</label>
              <label class="ck"><input type="checkbox" data-sim="t" /> {ui.simTendon}</label>
              <div class="grips" role="group" aria-label={ui.simGrip}>
                <span class="grips-k">{ui.simGrip}</span>
                {GRIPS.map((g, i) => <button type="button" class="grip-btn" data-grip={g} aria-pressed={i === 0 ? 'true' : 'false'}>{(ui.grips as any)[g]}</button>)}
                <button type="button" class="co-btn" data-co>⚡ {ui.coBtn}</button>
              </div>
              </div>
            </div>
            <div class="scope-box">
              <canvas class="sim-cv" width="720" height="340" role="img" aria-label={`${ui.simRaw}; ${ui.simEnv}`}></canvas>
              <p class="sim-legend"><span><span class="k1">━</span> {sim.ch} 1</span><span><span class="k2">━</span> {sim.ch} 2</span><span><span class="k3">┅</span> {ui.simThr}</span></p>
            </div>
            <div class="hand-box">
              <svg class="hand" viewBox="40 14 196 286" role="img" aria-label={ui.handAlt}>
                <defs>
                  <radialGradient id="spot" cx="50%" cy="55%" r="60%"><stop offset="0" stop-color="#2756b8" stop-opacity="0.35" /><stop offset="1" stop-color="#2756b8" stop-opacity="0" /></radialGradient>
                  <linearGradient id="palmG" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#3a4352" /><stop offset="1" stop-color="#222831" /></linearGradient>
                  <linearGradient id="sockG" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#2a313c" /><stop offset="1" stop-color="#171c23" /></linearGradient>
                </defs>
                <ellipse cx="120" cy="170" rx="118" ry="130" fill="url(#spot)" />
                <path d="M30 296H210" class="floor" />
                <path d="M84 232H156L164 292H76Z" fill="url(#sockG)" class="sock" />
                <rect x="88" y="246" width="20" height="12" rx="3" class="elc elc-1" />
                <rect x="132" y="246" width="20" height="12" rx="3" class="elc elc-2" />
                <text x="98" y="275" class="elc-t" text-anchor="middle">1</text>
                <text x="142" y="275" class="elc-t" text-anchor="middle">2</text>
                <rect x="92" y="214" width="56" height="20" rx="6" class="wrist" />
                <circle cx="120" cy="224" r="5" class="pin" /><path d="M117 224h6M120 221v6" class="pin-x" />
                <rect x="64" y="118" width="112" height="98" rx="12" fill="url(#palmG)" class="palm" />
                <path d="M74 124h92" class="palm-hl" />
                {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <g class="stud"><circle cx={86 + c * 34} cy={142 + r * 28} r="9" /><circle cx={84 + c * 34} cy={140 + r * 28} r="4" class="stud-hl" /></g>))}
                <g class="digits"></g>
              </svg>
              <p class="grip-now"><span>{ui.simGrip}:</span> <strong class="grip-name">{ui.grips.power}</strong></p>
            </div>
          </div>
          <p class="sim-note">{ui.simGripNote}</p>
          <p class="sim-note dim">{ui.simNote}</p>
        </div>
      </div>
    </section>

    <!-- ============================================================ 07 PITFALLS -->
    <section class="band" id="pitfalls">
      <div class="container">
        <header class="sec-h"><span class="sec-n">07</span><span class="sec-k">{ui.sec.pitfalls}</span></header>
        <h2 class="h2">{ui.pitfallsTitle}</h2>
        <ul class="tiles">{D.pitfalls.map((p: any) => <li><h3>{tx(p.title)}</h3><p>{tx(p.text)}</p><span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span></li>)}</ul>
      </div>
    </section>

    <!-- ============================================================ 08 SYSTEMS -->
    <section class="band band-alt" id="systems">
      <div class="container">
        <header class="sec-h"><span class="sec-n">08</span><span class="sec-k">{ui.sec.systems}</span></header>
        <h2 class="h2">{ui.systemsTitle}</h2>
        <div class="systems">
          {['direct', 'pr'].map((m) => (
            <div class="sys-col">
              <h3 class="sys-h">{tx(D.modes[m].label)}</h3>
              <ul class="sys-list">{D.systems[m].map((s: any) => <li><strong>{s.name}</strong><span>{tx(s.note)}</span><a href={s.url} rel="noopener">{ui.source2} ↗</a></li>)}</ul>
            </div>
          ))}
        </div>
        <p class="fine">{ui.systemsNote}</p>
      </div>
    </section>

    <!-- ============================================================ 09 EVIDENCE -->
    <section class="band" id="evidence">
      <div class="container">
        <header class="sec-h"><span class="sec-n">09</span><span class="sec-k">{ui.sec.evidence}</span></header>
        <h2 class="h2">{ui.evidenceTitle}</h2>
