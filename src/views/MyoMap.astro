    over: `<line x1="149" y1="182" x2="282" y2="205" class="membrane"/><ellipse cx="132" cy="178" rx="18" ry="15" class="bone"/><ellipse cx="296" cy="209" rx="15" ry="12" transform="rotate(-30 296 209)" class="bone"/><text x="132" y="181" class="bonelbl">${lang === 'uk' ? 'ПК' : 'R'}</text><text x="296" y="212" class="bonelbl">${lang === 'uk' ? 'ЛК' : 'U'}</text>`,
