    depth: 'Під електродом', at: 'на глибині', from: 'від глибини', skinOnly: 'у межах 15 мм під електродом м\'язів немає', model: 'у моделі',
    tendonM: 'сухожилкова частина', schem: 'контур схематичний: підтвердьте пальпацією та міотестом',
    role: 'Роль на цьому рівні', eff: 'Очікуване зусилля', deep: 'м\'яз глибокий або малодоступний для поверхневої ЕМГ',
    belly: 'Видима площа черевця в цій проєкції', csa: 'Площа поперечного перерізу на цьому рівні', cm2: 'см²', diam: 'діаметр найбільшого вписаного кола',
  },
  en: {
    over: 'Over the belly of', of: 'of the electrode area', tendonPart: 'over a tendinous zone', bonePart: 'over subcutaneous bone', nonePart: 'off the muscles',
    others: 'The electrode also overlaps', near: 'Within 5 mm of the border with', xtRisk: 'crosstalk risk increases', none: 'No muscle under the electrode: no signal',
    orientOk: 'The electrode axis matches the muscle axis', orientWarn: 'Deviation from the muscle axis', orientBad: 'The electrode is turned across the muscle',
    contactsOk: 'All contacts over the belly of the same muscle', contactsBad: 'The contacts fall on different structures',
    fits: 'The widest part of the belly fits a circle of diameter', narrow: 'the belly is narrower than the electrode',
    good: 'Good placement', fair: 'Could be improved', poor: 'Poor placement',
    dist: 'Distance between channels 1 and 2', antag: 'channels over antagonists (flexors and extensors)', sameM: 'both channels over the same muscle: the signals will not be independent', sameG: 'both channels over the same functional group',
    depth: 'Under the electrode', at: 'at a depth of', from: 'from a depth of', skinOnly: 'no muscle within 15 mm under the electrode', model: 'in the model',
    tendonM: 'tendinous part', schem: 'schematic outline: confirm by palpation and myotesting',
    role: 'Role at this level', eff: 'Expected effort', deep: 'a deep muscle, poorly accessible to surface EMG',
    belly: 'Visible belly area in this view', csa: 'Cross-sectional area at this level', cm2: 'cm²', diam: 'diameter of the largest inscribed circle',
  },
}[lang];
const clientData = {
  lang, views: clientViews, muscles: clientMuscles, bones: clientBones, roles: clientRoles, roleNames, effortNames, el: clientEl, fb,
  ui: { ch: lang === 'uk' ? 'Канал' : 'Channel', mm: ui.mm, simState: ui.simState, raw: ui.simRaw, env: ui.simEnv, armed: lang === 'uk' ? 'Натисніть на м\'яз, щоб поставити електрод' : 'Click a muscle to place the electrode' },
};

const fmtDate = new Intl.DateTimeFormat(lang === 'uk' ? 'uk-UA' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(D.meta.updated));
const roleOf = (lv: string, key: string) => D.levels[lv].roles[key] ?? 'context';
const isTmr = (lv: string, key: string) => (D.muscles[key]?.tmr ?? []).includes(lv);
const elSvg = (e: any, sc = 2.1) => {
  const W = (e.flange ? e.flange[0] : e.w) * sc + 6;
  const H = (e.flange ? e.flange[1] : Math.max(e.h, 14)) * sc + 6;
  const cx = W / 2, cy = H / 2;
  let s = `<svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" aria-hidden="true">`;
  if (e.flange) s += `<ellipse cx="${cx}" cy="${cy}" rx="${(e.flange[0] * sc) / 2}" ry="${(e.flange[1] * sc) / 2}" class="pe-fl"/>`;
  if (e.domes?.length) {
    s += `<rect x="${cx - (e.w * sc) / 2}" y="${cy - (e.h * sc) / 2}" width="${e.w * sc}" height="${e.h * sc}" rx="${(e.h * sc) / 2}" class="pe-pad"/>`;
    for (const d of e.domes) s += `<circle cx="${cx + d * sc}" cy="${cy}" r="${3.4 * sc}" class="pe-dome"/>`;
  } else {
    s += `<rect x="${cx - (e.w * sc) / 2}" y="${cy - (e.h * sc) / 2}" width="${e.w * sc}" height="${e.h * sc}" rx="${3 * sc}" class="pe-body"/>`;
    for (const c of e.contacts) s += `<rect x="${cx + (c.x - c.w / 2) * sc}" y="${cy - (c.h * sc) / 2}" width="${c.w * sc}" height="${c.h * sc}" rx="${(c.w * sc) / 2}" class="pe-ct"/>`;
  }
  return s + '</svg>';
};
const modeKeys = ['direct', 'pr', 'tmr'];
---

<Base lang={lang} title={ui.title} description={ui.lead} altLangHref={localePath(other, 'tools/myotesting-map/')}>
  <div class="container page" data-pagefind-body>
    <nav class="crumbs" aria-label={ui.crumbs}><a href={localePath(lang, 'tools/')}>← {ui.crumbs}</a></nav>
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 class="h-page">{ui.title}</h1>
    <p class="lead-muted">{ui.lead}</p>
    <div class="meta-row">
      <span class="badge-ev"><span class="dot" aria-hidden="true"></span>{ui.evidenceBadge}</span>
      <span class="mono small">{ui.version} {D.meta.version} · {ui.updated} {fmtDate}</span>
      <a class="small text-link" href="#how-it-works">{ui.howWorksTitle} ↓</a>
    </div>
    <section class="scope" aria-labelledby="scope-h">
      <h2 id="scope-h" class="scope-h">{ui.scopeTitle}</h2>
      <p>{ui.scope}</p>
    </section>
    <aside class="warn" role="note"><strong>{ui.warnTitle}.</strong>{' '}{ui.warn}</aside>
    <details class="how">
      <summary>{ui.howTitle}</summary>
      <ol>{ui.how.map((h) => <li>{h}</li>)}</ol>
    </details>
    <noscript><p class="warn">{ui.noscript}</p></noscript>

    <script type="application/json" id="mm-data" set:html={JSON.stringify(clientData)} />

    <div class="mm" data-level={START_LEVEL} data-view={START_VIEW} data-mode="direct" data-weak="on" data-labels="off">
      <div class="controls">
        <div class="ctl">
          <span class="ctl-label" id="lbl-level">{ui.level}</span>
          <div class="seg" role="group" aria-labelledby="lbl-level">
            {LEVELS.map((lv) => <button type="button" class="seg-btn" data-set-level={lv} aria-pressed={lv === START_LEVEL ? 'true' : 'false'}>{tx(D.levels[lv].title)}</button>)}
          </div>
        </div>
        <div class="ctl">
          <span class="ctl-label" id="lbl-view">{ui.view}</span>
          <div class="seg" role="group" aria-labelledby="lbl-view">
            {LEVELS.map((lv) => [
              ...D.levels[lv].views.map((v: any) => <button type="button" class="seg-btn vbtn" data-lv={lv} data-set-view={v.id} aria-pressed={v.id === START_VIEW ? 'true' : 'false'}>{tx(v.label)}</button>),
              ...(D.levels[lv].sections.length ? [<button type="button" class="seg-btn vbtn" data-lv={lv} data-set-view={D.levels[lv].sections[0].id} data-sec-btn="1" aria-pressed="false">{ui.section}</button>] : []),
            ])}
          </div>
        </div>
        <div class="ctl">
          <span class="ctl-label" id="lbl-mode">{ui.mode}</span>
          <div class="seg" role="group" aria-labelledby="lbl-mode">
            {modeKeys.map((m) => <button type="button" class="seg-btn" data-set-mode={m} aria-pressed={m === 'direct' ? 'true' : 'false'}>{tx(D.modes[m].label)}</button>)}
          </div>
        </div>
        <div class="ctl">
          <span class="ctl-label">{ui.layers}</span>
          <div class="toggles">
            <label><input type="checkbox" data-toggle="weak" checked /> {ui.weak}</label>
            <label><input type="checkbox" data-toggle="labels" /> {ui.labels}</label>
            <label><input type="checkbox" data-toggle="align" checked /> {ui.align}</label>
          </div>
        </div>
      </div>
      {modeKeys.map((m) => <p class="mode-desc" data-for={m}>{tx(D.modes[m].desc)}</p>)}

      <div class="seclevels">
        <span class="ctl-label">{ui.sectionLevel}</span>
        {LEVELS.map((lv) => D.levels[lv].sections.map((s: any) => <button type="button" class="chip-btn" data-lv={lv} data-set-view={s.id} aria-pressed="false">{tx(s.label)}</button>))}
      </div>

      <div class="workspace">
        <div class="stage-col">
          <div class="palette">
            <div class="pal-head"><span class="ctl-label">{ui.palette}</span><span class="pal-hint">{ui.paletteHint}</span></div>
            <div class="pal-list">
              {D.electrodes.map((e: any, i: number) => (
                <button type="button" class="pal-item" data-el={e.id} aria-pressed={i === 0 ? 'true' : 'false'} title={tx(e.note)}>
                  <span class="pal-svg" set:html={elSvg(e)} />
                  <span class="pal-txt">
                    <span class="pal-name">{tx(e.name)}</span>
                    <span class="pal-ex">{e.example}</span>
                    <span class="pal-ex">{e.dims ? `${e.w} × ${e.h} ${ui.mm}` : lang === 'uk' ? 'контур схематичний' : 'schematic outline'}</span>
                  </span>
                </button>
              ))}
            </div>
            <div class="pal-actions">
              <button type="button" class="btn btn-secondary btn-sm" data-act="ring">{ui.ring}</button>
              <button type="button" class="btn btn-secondary btn-sm" data-act="clear">{ui.clear}</button>
            </div>
          </div>

          <figure class="fig">
            <p class="armed-hint" aria-live="polite"></p>
            <div class="tip" aria-hidden="true"></div>
            {LEVELS.map((lv) =>
              D.levels[lv].views.map((v: any) => {
                const g = GEO[v.id];
                const muscles = g.structs.filter((s: any) => s.kind === 'muscle');
                return (
                  <div class="stage-wrap" data-stage={v.id} hidden={v.id !== START_VIEW}>
                    <div class="orient"><span>← {ORIENT[v.id][0]}</span><span>{tx(v.label)}</span><span>{ORIENT[v.id][1]} →</span></div>
                    <svg class="stage" viewBox={`0 0 ${g.w} ${g.h}`} data-view={v.id} role="group" aria-label={`${tx(D.levels[lv].title)}: ${tx(v.label)}`}>
                      <defs>
                        <pattern id={`h-${v.id}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" class="hb" /><line x1="0" y1="0" x2="0" y2="7" class="hl" /></pattern>
                        <pattern id={`w-${v.id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><line x1="0" y1="0" x2="0" y2="6" class="wl" /></pattern>
                      </defs>
                      <path class="skin" d={g.skin} />
                      <image href={url(`myomap/${v.id}.webp`)} width={g.w} height={g.h} class="shade" />
                      <g class="structs">
                        {g.structs.map((s: any) =>
                          s.kind === 'bone' ? (
                            <path class="bone hit" data-bone={s.key} d={s.d} fill-rule="evenodd" />
                          ) : s.kind === 'ctx' ? (
                            <path class="ctx" d={s.d} fill-rule="evenodd" />
                          ) : (
                            <path class={`mus hit${s.schematic ? ' schem' : ''}`} data-key={s.key} data-role={roleOf(lv, s.key)} d={s.d} fill-rule="evenodd" tabindex="0" role="button" aria-label={tx(D.muscles[s.key]?.name)} />
                          ),
                        )}
                      </g>
                      <g class="tz-g" aria-hidden="true">{muscles.filter((s: any) => s.t).map((s: any) => <path class="tz" data-tz={s.key} d={s.t} fill-rule="evenodd" />)}</g>
                      <g class="weak-g" aria-hidden="true">
                        {muscles.filter((s: any) => s.t).map((s: any) => <path d={s.t} fill={`url(#w-${v.id})`} fill-rule="evenodd" />)}
                        {g.structs.filter((s: any) => s.kind === 'bone').map((s: any) => <path d={s.d} fill={`url(#w-${v.id})`} fill-rule="evenodd" />)}
                      </g>
                      <g class="tmr-g" aria-hidden="true">{muscles.filter((s: any) => isTmr(lv, s.key)).map((s: any) => <path d={s.d} fill={`url(#h-${v.id})`} class="tmrp" fill-rule="evenodd" />)}</g>
                      <g class="sel-g" aria-hidden="true" />
                      <g class="lbl-g" aria-hidden="true">{muscles.filter((s: any) => (s.belly_cm2 ?? 0) > 1.2).map((s: any) => <text x={s.site[0]} y={s.site[1]} class="lbl">{ABBR[s.key]}</text>)}</g>
                      <g class="els" />
                    </svg>
                  </div>
                );
              }),
            )}
            {LEVELS.map((lv) =>
              D.levels[lv].sections.map((sv: any) => {
                const g = SEC[sv.id];
                const left = lv === 'ph' ? ui.radial : ui.sideL;
                const right = lv === 'ph' ? ui.ulnar : ui.sideM;
                return (
                  <div class="stage-wrap" data-stage={sv.id} hidden>
                    <div class="orient"><span>← {left}</span><span>{ui.section}: {tx(sv.label)}</span><span>{right} →</span></div>
                    <svg class="stage sec" viewBox={`-32 -32 ${g.w + 64} ${g.h + 64}`} data-view={sv.id} role="group" aria-label={`${ui.section}: ${tx(sv.label)}`}>
                      <defs><pattern id={`w-${sv.id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><line x1="0" y1="0" x2="0" y2="6" class="wl" /></pattern></defs>
                      <path class="skin sec-skin" d={g.skin} />
                      <g class="structs">
                        {g.structs.map((s: any) =>
                          s.kind === 'bone' ? (
                            <path class="bone hit flat" data-bone={s.key} d={s.d} fill-rule="evenodd" />
                          ) : s.kind === 'ctx' ? (
                            <path class="ctx flat" d={s.d} fill-rule="evenodd" />
                          ) : (
                            <path class={`mus hit flat${s.tendon ? ' tendon' : ''}`} data-key={s.key} data-role={roleOf(lv, s.key)} d={s.d} fill-rule="evenodd" tabindex="0" role="button" aria-label={tx(D.muscles[s.key]?.name)} />
                          ),
                        )}
                      </g>
                      <g class="weak-g" aria-hidden="true">
                        {g.structs.filter((s: any) => s.tendon || s.kind === 'bone').map((s: any) => <path d={s.d} fill={`url(#w-${sv.id})`} fill-rule="evenodd" />)}
                      </g>
                      <g class="sel-g" aria-hidden="true" />
                      <g class="lbl-g on" aria-hidden="true">{g.structs.filter((s: any) => s.kind === 'muscle' && !s.tendon && (s.area_cm2 ?? 0) > (lv === 'ph' ? 0.15 : 0.45)).map((s: any) => <text x={s.site[0]} y={s.site[1]} class="lbl sl">{ABBR[s.key]}</text>)}</g>
                      <g class="els" />
                    </svg>
                    <p class="sec-cap">{ui.fromBelow[lv]}</p>
                  </div>
                );
              }),
            )}
            <figcaption>{ui.credit} · <a href="#anatomy-source">{ui.sourceTitle}</a></figcaption>
            <div class="legend">
              <ul class="lg lg-roles">
                {['primary', 'secondary', 'caution', 'conditional', 'deep', 'context'].map((r) => <li><span class={`sw sw-${r}`} aria-hidden="true" />{tx(D.roles[r])}</li>)}
              </ul>
              <ul class="lg lg-extra">
                <li class="lg-weak"><span class="sw sw-weak" aria-hidden="true" /><a href="#weak">{ui.weak}</a></li>
                <li class="lg-tmr"><span class="sw sw-tmr" aria-hidden="true" />TMR: {ui.tmrHatch}</li>
              </ul>
            </div>
          </figure>
        </div>

        <div class="side">
          <section class="fb card-x" hidden aria-live="polite">
            <div class="fb-head"><h2 class="card-h fb-title">{ui.fbTitle}</h2><span class="fb-badge"></span></div>
            <ul class="fb-list"></ul>
            <div class="fb-actions">
              <button type="button" class="ic-btn" data-el-act="rotl" title={ui.rotL} aria-label={ui.rotL}>⟲</button>
              <button type="button" class="ic-btn" data-el-act="rotr" title={ui.rotR} aria-label={ui.rotR}>⟳</button>
              <button type="button" class="mini-btn" data-el-act="align">{ui.alignBtn}</button>
              <button type="button" class="mini-btn" data-el-act="site">{ui.siteBtn}</button>
              <button type="button" class="mini-btn danger" data-el-act="del">{ui.del}</button>
            </div>
            <p class="fb-pair"></p>
            <p class="fb-note small muted">{ui.fbNote}</p>
          </section>

          <div class="cards">
            {LEVELS.map((lv) => (
              <article class="card-x card-intro" data-intro={lv} hidden={lv !== START_LEVEL}>
                <h2 class="card-h">{tx(D.levels[lv].title)}</h2>
                <p>{tx(D.levels[lv].intro)}</p>
                {modeKeys.map((m) => <p class="note" data-for={m}><span class="note-k">{tx(D.modes[m].label)}</span>{tx(D.levels[lv].modeNotes[m])}</p>)}
                <h3>{ui.levelPit}</h3>
                <ul class="pit">{D.levels[lv].pitfalls.map((p: any) => <li>{tx(p)}</li>)}</ul>
                <p class="pick">{ui.pick}</p>
              </article>
            ))}
            {Object.entries(D.muscles).map(([k, m]: [string, any]) => (
              <article class="card-x card-m" data-card={k} hidden>
                <p class="role-badge"></p>
                <h2 class="card-h">{tx(m.name)}{m.syn && <span class="syn"> ({tx(m.syn)})</span>}</h2>
                <p class="latin">{m.latin}{lang === 'uk' && <span class="en-n"> · {m.name.en}</span>}</p>
                {m.schematic && <p class="schem-note">{ui.schematic}</p>}
                <dl class="anat">
                  <dt>{ui.origin}</dt><dd>{tx(m.origin)}</dd>
                  <dt>{ui.insertion}</dt><dd>{tx(m.insertion)}</dd>
                  <dt>{ui.nerve}</dt><dd>{tx(m.nerve)}</dd>
                  <dt>{ui.action}</dt><dd>{tx(m.action)}</dd>
                </dl>
                {m.why && <><h3>{ui.why}</h3><p>{tx(m.why)}</p></>}
                {m.cmd && <><h3>{ui.cmd}</h3><p>{tx(m.cmd)}</p></>}
                {m.xt && <><h3>{ui.xt}</h3><p>{tx(m.xt)}</p></>}
                {m.effort && <><h3>{ui.effort}</h3><p><span class={`eff eff-${m.effort.level}`}>{tx(D.effort.levels[m.effort.level])}</span> {tx(m.effort.text)}</p></>}
                <p class="area-line small muted"></p>
                <div class="card-actions">
                  <button type="button" class="btn btn-secondary btn-sm place-here" data-place={k}>{ui.placeHere}</button>
                  <button type="button" class="back text-link">{ui.back}</button>
                </div>
              </article>
            ))}
            {Object.entries(D.bones).map(([k, b]: [string, any]) => (
              <article class="card-x card-m" data-card={`bone:${k}`} hidden>
                <p class="role-badge rb-bone">{lang === 'uk' ? 'Кістка або сполучнотканинна структура' : 'Bone or connective tissue'}</p>
                <h2 class="card-h">{tx(b.name)}</h2>
                <p class="latin">{b.latin}</p>
                <p>{tx(b.note)}</p>
                <button type="button" class="back text-link">{ui.back}</button>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>

    <section class="block" id="weak">
      <h2 class="h-sub">{ui.weakTitle}</h2>
      <ul class="tiles">
        {D.weak.map((w: any) => <li><h3>{tx(w.title)} <span class={`basis basis-${w.basis}`}>{(ui.basis as any)[w.basis]}</span></h3><p>{tx(w.text)}</p></li>)}
      </ul>
    </section>

    <section class="block" id="effort">
      <h2 class="h-sub">{ui.effortTitle}</h2>
      <p class="block-lead">{tx(D.effort.intro)}</p>
      <ul class="principles">
        {D.effort.principles.map((p: any) => <li><span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span> {tx(p.text)}</li>)}
      </ul>
      <p class="eff-legend">{['low', 'moderate', 'high'].map((k) => <span class={`eff eff-${k}`}>{tx(D.effort.levels[k])}</span>)}</p>
      <p class="small muted">{tx(D.effort.note)}</p>
    </section>

    <section class="block" id="how-it-works">
      <h2 class="h-sub">{ui.howWorksTitle}</h2>
      <ol class="steps">
        {D.how.map((s: any, i: number) => <li><span class="step-n">{i + 1}</span><div><h3>{tx(s.t)}</h3><p>{tx(s.x)}</p></div></li>)}
      </ol>
      <div class="sim card-x">
        <h3 class="sim-title">{ui.simTitle}</h3>
        <div class="sim-grid">
          <div class="sim-ctl">
            <label class="sl"><span>{ui.simOpen}</span><input type="range" min="0" max="100" value="0" data-sim="a" /></label>
            <label class="sl"><span>{ui.simClose}</span><input type="range" min="0" max="100" value="0" data-sim="b" /></label>
            <label class="sl"><span>{ui.simThr}</span><input type="range" min="5" max="60" value="25" data-sim="thr" /></label>
            <label class="ck"><input type="checkbox" data-sim="x" /> {ui.simCross}</label>
            <label class="ck"><input type="checkbox" data-sim="t" /> {ui.simTendon}</label>
            <p class="sim-state" aria-live="polite">{ui.simState.idle}</p>
          </div>
          <div class="sim-plot">
            <canvas class="sim-cv" width="720" height="320" role="img" aria-label={`${ui.simRaw}; ${ui.simEnv}`}></canvas>
            <p class="sim-legend"><span class="k1">■</span> {lang === 'uk' ? 'Канал 1' : 'Channel 1'} · <span class="k2">■</span> {lang === 'uk' ? 'Канал 2' : 'Channel 2'} · {ui.simRaw} / {ui.simEnv}</p>
          </div>
          <svg class="sim-hand" viewBox="0 0 120 140" aria-hidden="true">
            <g class="sh-f2"><rect x="58" y="14" width="13" height="72" rx="6.5" class="sh-fin" /><rect x="72" y="18" width="13" height="68" rx="6.5" class="sh-fin" /></g>
            <g class="sh-f1"><rect x="30" y="42" width="15" height="48" rx="7.5" class="sh-fin" /></g>
            <rect x="34" y="78" width="54" height="50" rx="12" class="sh-palm" />
          </svg>
        </div>
        <p class="small muted">{ui.simNote}</p>
      </div>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.pitfallsTitle}</h2>
      <ul class="tiles">{D.pitfalls.map((p: any) => <li><h3>{tx(p.title)} <span class={`basis basis-${p.basis}`}>{(ui.basis as any)[p.basis]}</span></h3><p>{tx(p.text)}</p></li>)}</ul>
    </section>

    <section class="block">
      <h2 class="h-sub">{ui.systemsTitle}</h2>
      <div class="systems">
        {['direct', 'pr'].map((m) => (
          <div>
            <h3 class="sys-h">{tx(D.modes[m].label)}</h3>
