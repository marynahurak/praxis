      fds: sector(TR, 56, 84),
      pl: sector(TR, 84, 98, 0.74),
      fcr: sector(TR, 98, 122),
      pt: sector(TR, 122, 146),
      br: sector(TR, 146, 182),
      ecrl: sector(TR, 182, 203),
      ecrb: sector(TR, 203, 224),
      ed: sector(TR, 224, 262),
      edm: sector(TR, 262, 276),
      ecu: sector(TR, 276, 318),
      ulna: { ...sector(TR, 318, 342), label: [326, 240] },
      fdp: { shapes: [e(245, 141, 30, 15, -15)], label: [245, 144] },
      fpl: { shapes: [e(160, 136, 22, 12, 20)], label: [160, 139] },
      sup: { shapes: [e(128, 200, 20, 9, 25)], label: [150, 208] },
      deepext: { shapes: [e(208, 214, 32, 11, 8)], label: [208, 217] },
    },
  },
  th: {
    frame: TH,
    ring: true,
    outline: `<ellipse cx="200" cy="168" rx="126" ry="118" class="skin"/><ellipse cx="200" cy="168" rx="75.6" ry="70.8" class="deeptissue"/>`,
    over: `<ellipse cx="196" cy="172" rx="22" ry="21" class="bone"/><text x="196" y="175" class="bonelbl">${lang === 'uk' ? 'ПлК' : 'H'}</text><circle cx="297" cy="152" r="5" class="artery"/><circle cx="289" cy="163" r="3.5" class="nerve"/><circle cx="304" cy="163" r="3.5" class="nerve"/>`,
    geo: {
      biceps: sector(TH, 35, 140),
      brachialis: { shapes: [...sector(TH, 140, 160).shapes, e(198, 126, 38, 13)], label: [124, 108] },
      deltoid: sector(TH, 160, 205),
      tri_lat: sector(TH, 205, 252),
      tri_long: sector(TH, 252, 333),
      nv: { ...sector(TH, 333, 395), label: [312, 186] },
      tri_med: { shapes: [e(200, 214, 34, 11)], label: [200, 217] },
      coraco: { shapes: [e(246, 135, 13, 9, 20)], label: [246, 138] },
    },
  },
  ph: {
    frame: PH,
    outline: `<g class="skin-union"><ellipse cx="200" cy="168" rx="168" ry="72" class="skin-stroke"/><ellipse cx="78" cy="156" rx="52" ry="50" class="skin-stroke"/><ellipse cx="200" cy="168" rx="168" ry="72" class="skin-fill"/><ellipse cx="78" cy="156" rx="52" ry="50" class="skin-fill"/></g>`,
    over: `<ellipse cx="74" cy="160" rx="11" ry="10" class="bone"/><circle cx="150" cy="178" r="12" class="bone"/><circle cx="190" cy="180" r="11" class="bone"/><circle cx="228" cy="180" r="10.5" class="bone"/><circle cx="265" cy="176" r="10" class="bone"/><text x="74" y="163" class="bonelbl">I</text><text x="150" y="181" class="bonelbl">II</text><text x="190" y="183" class="bonelbl">III</text><text x="228" y="183" class="bonelbl">IV</text><text x="265" y="179" class="bonelbl">V</text>`,
    geo: {
      thenar: { shapes: [e(82, 146, 40, 32)], label: [84, 136] },
      fdi: { shapes: [e(110, 194, 22, 11, -18)], label: [110, 197] },
      hypothenar: { shapes: [e(310, 160, 34, 30)], label: [312, 163] },
      dio: { shapes: [e(170, 194, 9, 8), e(209, 196, 9, 8), e(247, 194, 9, 8)], label: [209, 222] },
      addpol: { shapes: [e(126, 160, 28, 9, 8)], label: [122, 152] },
      pio: { shapes: [e(170, 168, 7, 6), e(209, 168, 7, 6), e(247, 166, 7, 6)], label: [209, 158] },
      flextend: {
        shapes: [148, 162, 186, 200, 224, 238, 262, 276].map((x) => e(x, 130, 5.5, 5.5)),
        label: [212, 117],
      },
      exttend: { shapes: [150, 190, 228, 265].map((x) => e(x, 214, 4.5, 4.5)), label: [150, 230] },
    },
  },
  sd: {
    outline: `<path d="M188 30L152 30L150 56C128 68 100 72 76 78C48 84 32 102 34 128C36 150 48 164 54 184L60 258C62 288 64 306 66 318L188 318Z" class="skin"/><path d="M188 30V318" class="midline"/><path d="M212 30L248 30L250 56C272 68 300 72 324 78C352 84 368 102 366 128C364 150 352 164 346 184L340 258C338 288 336 306 334 318L212 318Z" class="skin"/><path d="M212 30V318" class="midline"/><path d="M268 92L350 98L342 130L300 214L266 170Z" class="scapula"/>`,
    geo: {
      delt_sd: {
        shapes: [
          { d: 'M40 106C50 90 66 84 80 84L84 98C84 114 84 126 88 136C70 146 52 148 42 138C38 126 38 114 40 106Z' },
          { d: 'M352 100C362 108 368 120 366 134C358 146 350 150 344 144L348 116Z' },
        ],
        label: [62, 118],
      },
      trap: {
        shapes: [
          { d: 'M151 56C130 67 104 73 80 79L82 88C108 82 134 76 153 68Z' },
          { d: 'M214 40L248 40L250 58C272 68 300 72 326 80L330 92C300 90 268 90 250 86L214 84Z' },
        ],
        label: [262, 70],
      },
      pm_clav: { shapes: [{ d: 'M86 96C116 90 150 84 182 78L185 112C152 116 118 122 94 128C88 118 86 106 86 96Z' }], label: [138, 105] },
      pm_stern: { shapes: [{ d: 'M95 133C118 127 152 121 185 117L187 192C160 198 128 192 106 178C94 166 87 150 95 133Z' }], label: [142, 158] },
      lat: {
        shapes: [{ d: 'M56 190L76 184C80 220 84 248 84 280L64 280L60 246Z' }, { d: 'M216 220C260 214 306 218 344 204L340 268C318 280 276 294 216 306Z' }],
        label: [278, 262],
      },
      infra: { shapes: [{ d: 'M272 120L344 110L338 132L300 204L272 168Z' }], label: [302, 150] },
      teres: { shapes: [{ d: 'M304 208L338 140L350 152C346 174 330 198 314 214Z' }], label: [334, 182] },
      clav: { shapes: [{ d: 'M80 88C110 84 150 78 180 70L181 75C150 83 110 89 81 93Z' }], label: [160, 66] },
      scap: { shapes: [{ d: 'M268 110L352 100L352 105L268 115Z' }], label: [352, 94] },
    },
  },
};

const LEVEL_IDS = ['ph', 'tr', 'th', 'sd'] as const;
const MODE_IDS = ['direct', 'pr', 'tmr'] as const;
const levels = data.levels as Record<string, any>;
const roles = data.roles as Record<string, L10n>;
const modes = data.modes as Record<string, { label: L10n; desc: L10n }>;
const systems = data.systems as Record<string, { name: string; note: L10n; url: string }[]>;

const ringDots = (F: Frame) =>
  Array.from({ length: 8 }, (_, k) => {
    const [x, y] = pt(F, 90 + k * 45, 1.075);
    return { x: R(x), y: R(y), n: k + 1 };
  });

const fmtDate = new Intl.DateTimeFormat(lang === 'uk' ? 'uk-UA' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(
  new Date(data.meta.updated),
);
---

<Base lang={lang} title={ui.title} description={ui.lead} altLangHref={localePath(other, 'tools/myotesting-map/')}>
  <div class="container page" data-pagefind-body>
    <nav class="crumbs" aria-label={ui.crumbs}><a href={localePath(lang, 'tools/')}>← {ui.crumbs}</a></nav>
    <p class="eyebrow">{ui.eyebrow}</p>
    <h1 class="h-page">{ui.title}</h1>
    <p class="lead-muted">{ui.lead}</p>

    <div class="meta-row">
      <span class="badge-ev" title={ui.evidenceHint}><span class="dot" aria-hidden="true"></span>{ui.evidenceBadge}</span>
      <span class="mono small">{ui.version} {data.meta.version} · {ui.updated} {fmtDate}</span>
    </div>

    <aside class="warn" role="note" aria-label={ui.warnTitle}>
      <strong>{ui.warnTitle}.</strong>{' '}{ui.warn}
    </aside>

    <details class="how">
      <summary>{ui.howTitle}</summary>
      <ol>{ui.how.map((h) => <li>{h}</li>)}</ol>
    </details>

    <div class="mm" data-level="tr" data-mode="direct">
      <div class="controls">
        <div class="ctl">
          <span class="ctl-label mono" id="lvl-label">{ui.levelLabel}</span>
          <div class="seg" role="tablist" aria-labelledby="lvl-label">
            {
              LEVEL_IDS.map((id) => (
                <button type="button" role="tab" class="seg-btn" data-level={id} id={`tab-${id}`} aria-controls={`panel-${id}`} aria-selected={id === 'tr' ? 'true' : 'false'}>
                  {tx(levels[id].title)}
                </button>
              ))
            }
          </div>
        </div>
        <div class="ctl">
          <span class="ctl-label mono" id="mode-label">{ui.modeLabel}</span>
          <div class="seg" role="group" aria-labelledby="mode-label">
            {
              MODE_IDS.map((m) => (
                <button type="button" class="seg-btn" data-mode={m} aria-pressed={m === 'direct' ? 'true' : 'false'}>
                  {m === 'tmr' ? 'TMR' : tx(modes[m].label)}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      {
        LEVEL_IDS.map((id) => {
          const lv = levels[id];
          const lay = LAYOUT[id];
          return (
            <section class="panel" id={`panel-${id}`} role="tabpanel" aria-labelledby={`tab-${id}`} data-level={id} hidden={id !== 'tr'}>
              <div class="grid">
                <figure class="fig">
                  <svg viewBox="0 0 400 330" class="map" role="group" aria-label={`${tx(lv.title)}: ${tx(lv.section)}`}>
                    <defs>
                      <pattern id={`hatch-${id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                        <rect width="6" height="6" class="hatch-bg" />
                        <line x1="0" y1="0" x2="0" y2="6" class="hatch-line" />
                      </pattern>
                    </defs>
                    <g set:html={lay.outline} />
                    {lay.under && <g set:html={lay.under} />}
                    {lv.muscles.map((m: any) => {
                      const g = lay.geo[m.id];
                      if (!g) return null;
                      const label = `${tx(m.name)} (${m.latin})`;
                      return (
                        <g class="m" tabindex="0" role="button" aria-pressed="false" aria-label={label} data-m={m.id} data-role={m.role} data-tmr={m.tmr ? 'true' : undefined}>
                          {g.shapes.map((s: any) =>
                            'd' in s ? (
                              <path d={s.d} class="shape" />
                            ) : (
                              <ellipse cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry} transform={s.rot ? `rotate(${s.rot} ${s.cx} ${s.cy})` : undefined} class="shape" />
                            ),
                          )}
                          {m.tmr &&
                            g.shapes.map((s: any) =>
                              'd' in s ? (
                                <path d={s.d} class="hatch" fill={`url(#hatch-${id})`} />
                              ) : (
                                <ellipse cx={s.cx} cy={s.cy} rx={s.rx} ry={s.ry} transform={s.rot ? `rotate(${s.rot} ${s.cx} ${s.cy})` : undefined} class="hatch" fill={`url(#hatch-${id})`} />
                              ),
                            )}
                        </g>
                      );
                    })}
                    <g class="sel-ov" aria-hidden="true" />
                    {lay.over && <g set:html={lay.over} class="over" />}
                    <g class="labels" aria-hidden="true">
                      {lv.muscles.map((m: any) => {
                        const g = lay.geo[m.id];
                        return g?.label ? (
                          <text x={g.label[0]} y={g.label[1]} class="lbl" data-role={m.role}>
                            {tx(m.abbr)}
                          </text>
                        ) : null;
                      })}
                    </g>
                    {lay.ring && lay.frame && (
                      <g class="ring" aria-hidden="true">
                        {ringDots(lay.frame).map((p) => (
                          <g>
                            <circle cx={p.x} cy={p.y} r="8" class="el" />
                            <text x={p.x} y={p.y + 3.5} class="el-n">
                              {p.n}
                            </text>
                          </g>
                        ))}
                      </g>
                    )}
                    {id === 'sd' ? (
                      <g class="orient" aria-hidden="true">
                        <text x="100" y="18">{tx(lv.orient.top)}</text>
                        <text x="306" y="18">{tx(lv.orient.bottom)}</text>
