---
// «Симулятор тягової системи протеза верхньої кінцівки» — сторінка інструмента (технічний модуль BP-SIM).
// Оформлення: темний технічний HUD (чорний / золотий / блакитний Praxis), креслення з позиційними позначками,
// «цеглинкова» графіка. Фізика — src/lib/bodypowered/physics.ts (тести: scripts/tests/bodypowered.test.mjs);
// тексти — content.ts; поведінка й малювання — src/scripts/bodypowered-client.ts.
import Base from '../layouts/Base.astro';
import { SITE, type Lang } from '../config';
import { localePath } from '../utils';
import { META, CHANGELOG, PARAMS, REFS, REF_ORDER, NOTATION, EQUATIONS, CHECKS, getUi, sym } from '../lib/bodypowered/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';
const ui = getUi(lang);
const otherTitle = getUi(other).title;
const pageUrl = new URL(localePath(lang, 'tools/body-powered-simulator/'), Astro.site).href;
const fmtDay = (d: string) => new Intl.DateTimeFormat(lang === 'uk' ? 'uk-UA' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(d));
const refNo = Object.fromEntries(REF_ORDER.map((k, i) => [k, i + 1]));
const author = SITE.author[lang];
const S = (h: string) => sym(lang, h);
const SECS: [string, string][] = [['01', ui.secScope], ['02', ui.secNotation], ['03', ui.secModel], ['04', ui.secParams], ['05', ui.secVV], ['06', ui.secLimits], ['07', ui.secPassport], ['08', ui.secRefs]];
const KEY_P: [string, string, string?][] = [['A', ui.cross], ['B', ui.control], ['C', ui.housing], ['D', ui.td], ['E', ui.axilla], ['F', ui.suspensor, 'k-f']];
const KEY_R: [string, string][] = [['1', ui.proxRet], ['2', ui.distRet], ['3', ui.housing], ['4', ui.lever], ['5', ui.fromHarness]];
const TEL: { k: string; label: string; s?: string; cls?: string }[] = [
  { k: 'open', label: ui.opening, s: 'x' },
  { k: 'exc', label: ui.excursion, s: S('ΔL<sub>гак</sub>') },
  { k: 'fout', label: ui.forceHook, s: S('F<sub>вих</sub>') },
  { k: 'fin', label: ui.forceBody, s: S('F<sub>вх</sub>') },
  { k: 'theta', label: ui.theta, s: 'θ', cls: 'only-pro' },
  { k: 'eta', label: ui.eta, s: 'η', cls: 'only-pro' },
  { k: 'finfull', label: S(ui.finFull), cls: 'only-pro' },
  { k: 'flim', label: S(ui.fatigueLimit), cls: 'only-pro' },
  { k: 'kcap', label: ui.capture, s: 'k', cls: 'only-pro' },
  { k: 'bodyneed', label: S(ui.bodyNeed), cls: 'only-pro' },
];
---

<Base lang={lang} title={ui.title} description={ui.lead} altLangHref={localePath(other, 'tools/body-powered-simulator/')}>
  <div class="bp" data-lang={lang}>
    <!-- ============================================================ HERO -->
    <section class="hero">
      <div class="lattice" aria-hidden="true"></div>
      <div class="container hero-in">
        <nav class="crumbs"><a href={localePath(lang, 'tools/')}>← {lang === 'uk' ? 'Інструменти' : 'Tools'}</a></nav>
        <p class="code"><span>{ui.code}</span><span class="code-v">v{META.version}</span><span class="code-k">{ui.kicker}</span></p>
        <h1 class="hero-h">{ui.title}</h1>
        <p class="hero-lead">{ui.lead}</p>
        <dl class="spec">
          {ui.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
        </dl>
        <div class="warn hud" role="note"><p class="warn-h"><span aria-hidden="true">▲</span> {ui.disclaimerTitle}</p><p>{ui.disclaimer}</p></div>
      </div>
    </section>

    <!-- ============================================================ SIMULATOR -->
    <section class="lab" id="simulator" aria-label={ui.short}>
      <div class="container">
        <div class="lab-bar">
          <div class="seg" role="tablist" aria-label={lang === 'uk' ? 'Режим' : 'Mode'}>
            <button type="button" role="tab" class="seg-b" data-mode="patient" aria-selected="true"><span>{ui.modePatient}</span><small>{ui.modePatientHint}</small></button>
            <button type="button" role="tab" class="seg-b" data-mode="pro" aria-selected="false"><span>{ui.modePro}</span><small>{ui.modeProHint}</small></button>
          </div>
          <div class="lab-actions">
            <button type="button" class="lb" data-act="reset">{ui.reset}</button>
            <button type="button" class="lb only-pro" data-act="snap" aria-pressed="false">{ui.snap}</button>
            <button type="button" class="lb" data-act="copy">{ui.copy}</button>
          </div>
        </div>

        <div class="lab-grid">
          <div class="scene">
            <div class="scene-main hud">
              <p class="scene-cap only-patient"><b>FIG. 1</b> · {ui.backView}</p>
              <p class="scene-cap only-pro"><b>FIG. 1</b> · {ui.sideScheme}</p>
              <svg class="sv sv-back only-patient" viewBox="0 0 640 600" role="img" aria-label={ui.backView}></svg>
              <svg class="sv sv-side only-pro" role="img" aria-label={ui.sideScheme}></svg>
              <ul class="key only-patient">{KEY_P.map(([t, l, c]) => <li class={c}><b>{t}</b>{l}</li>)}</ul>
              <ul class="key only-pro">
                {KEY_R.map(([t, l]) => <li><b>{t}</b>{l}</li>)}
                <li class="key-r">{lang === 'uk' ? 'R вигину оболонки:' : 'Housing bend radius:'} <i style="--c: #46c98b"></i>&gt; 60 <i style="--c: #e9b44c"></i>30–60 <i style="--c: #ff5d5d"></i>&lt; 30 {ui.mm}</li>
              </ul>
            </div>
            <div class="scene-sub">
              <figure class="mini hud">
                <figcaption><b>FIG. 2</b> · {ui.hookView}</figcaption>
                <svg class="sv sv-hook" viewBox="0 -34 300 204" role="img" aria-label={ui.hookView}></svg>
              </figure>
              <figure class="mini hud only-pro">
                <figcaption><b>FIG. 3</b> · {ui.backView} · [A] {ui.cross}</figcaption>
                <svg class="sv sv-cross" viewBox="0 0 300 204" role="img" aria-label={ui.cross}></svg>
              </figure>
              <figure class="mini mini-chart hud only-pro">
                <figcaption><b>FIG. 4</b> · <span set:html={S(ui.chartTitle)} /></figcaption>
                <svg class="sv sv-chart" viewBox="0 0 720 220" role="img" aria-label="η(θ)"></svg>
              </figure>
            </div>
            <p class="drag-hint only-pro">{ui.dragHint}</p>
          </div>

          <div class="panel hud">
            <div class="only-patient grp">
              <p class="hh"><span>00</span>{ui.gHarness}</p>
              <div class="harness" role="radiogroup" aria-label={ui.harness}>
                <button type="button" class="hb" data-h="8" role="radio" aria-checked="true"><strong>{ui.fig8}</strong><small>{ui.fig8Desc}</small></button>
                <button type="button" class="hb" data-h="9" role="radio" aria-checked="false"><strong>{ui.fig9}</strong><small>{ui.fig9Desc}</small></button>
              </div>
            </div>

            <div class="grp">
              <p class="hh"><span>01</span>{ui.gKin}</p>
              <label class="rng"><span>{ui.scap} <i>s</i></span><output data-v="scap"></output><input type="range" min="0" max="100" step="1" data-k="scap" /></label>
              <label class="rng"><span>{ui.gh} <i>φ</i></span><output data-v="gh"></output><input type="range" min="0" max="90" step="1" data-k="gh" /></label>
            </div>

            <div class="grp">
              <p class="hh"><span>02</span>{ui.gCfg}</p>
              <label class="rng"><span>{ui.bands}</span><output data-v="bands"></output><input type="range" min="1" max="4" step="1" data-k="bands" /></label>
              <p class="hint only-patient">{ui.bandsHint}</p>
              <div class="only-pro">
                <label class="rng"><span set:html={S(ui.approach)} /><output data-v="approach"></output><input type="range" min="0" max="80" step="1" data-k="approach" /></label>
                <p class="hint">{ui.approachHint}</p>
                <label class="rng"><span>{ui.slack}</span><output data-v="slack"></output><input type="range" min="0" max="45" step="1" data-k="slack" /></label>
                <label class="sel"><span>{ui.pair}</span>
                  <select data-k="pair">
                    <option value="ptfe">{ui.pairPtfe}</option>
                    <option value="unlined">{ui.pairUnlined}</option>
                    <option value="custom">{ui.pairCustom}</option>
                  </select>
                </label>
                <label class="rng rng-mu"><span>μ</span><output data-v="mu"></output><input type="range" min="0.05" max="0.4" step="0.005" data-k="mu" /></label>
                <label class="rng"><span set:html={S(ui.lreq)} /><output data-v="lReq"></output><input type="range" min="30" max="70" step="1" data-k="lReq" /></label>
                <p class="hint">{ui.lreqHint}</p>
              </div>
            </div>

            <div class="grp only-pro">
              <p class="hh"><span>03</span>{ui.gUser}</p>
              <label class="rng"><span set:html={S(ui.fmax)} /><output data-v="fMax"></output><input type="range" min="87" max="538" step="1" data-k="fMax" /></label>
              <p class="hint">{ui.fmaxHint}</p>
            </div>

            <div class="hud-out" aria-live="polite">
              <p class="hh"><span>04</span>{ui.gTel}</p>
              <div class="status" data-o="status"></div>
              <div class="bar" aria-hidden="true"><i data-o="excbar"></i></div>
              <div class="tel">
                {TEL.map((t) => (
                  <div class={`cell ${t.cls ?? ''}`}>
                    <p class="cell-l"><span set:html={t.label} />{t.s && <b set:html={t.s} />}</p>
                    <p class="cell-v" data-o={t.k}></p>
                  </div>
                ))}
              </div>
              <p class="cell-sub only-pro" data-o="thparts"></p>
              <div class="load">
                <div class="load-h"><span>{ui.load}</span><b data-o="loadtxt"></b></div>
                <div class="bar bar-load"><i data-o="loadbar"></i><span class="tick" aria-hidden="true"></span></div>
                <p class="hint" data-o="loadnote"></p>
              </div>
              <div class="cmp only-pro" data-o="cmp" hidden></div>
              <div class="flags only-pro">
                <p class="hh"><span>05</span>{ui.gDiag}</p>
                <ul data-o="flags"></ul>
              </div>
            </div>
          </div>
        </div>
        <noscript><p class="hint">{ui.noscript}</p></noscript>
      </div>
    </section>

    <!-- ============================================================ TECHNICAL SECTIONS -->
    <nav class="toc container" aria-label={lang === 'uk' ? 'Розділи' : 'Sections'}>
      {SECS.map(([n, t]) => <a href={`#s${n}`}><span>§ {n}</span>{t}</a>)}
    </nav>

    <section class="doc" id="s01">
      <div class="container narrow">
        <h2 class="dh"><span>§ 01</span>{ui.secScope}</h2>
        {ui.how.map((p) => <p class="body">{p}</p>)}
      </div>
    </section>

    <section class="doc" id="s02">
      <div class="container narrow">
        <h2 class="dh"><span>§ 02</span>{ui.secNotation}</h2>
        <div class="tbl-wrap hud">
          <table class="tbl notation">
            <thead><tr>{ui.notationHead.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>{NOTATION.map((r) => <tr><td class="symc" set:html={S(r.sym)} /><td set:html={S(r.q[lang])} /><td class="mono nw">{r.u[lang]}</td></tr>)}</tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="doc" id="s03">
      <div class="container narrow">
        <h2 class="dh"><span>§ 03</span>{ui.secModel}</h2>
        <p class="body">{ui.modelLead}</p>
        <ol class="eqs">
          {EQUATIONS.map((e) => (
            <li class="eq hud">
              <div class="eq-f" set:html={S(e.html)} />
              <span class="eq-n">({e.n})</span>
              <p class="eq-note" set:html={S(e.note[lang])} />
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="doc" id="s04">
      <div class="container">
        <h2 class="dh"><span>§ 04</span>{ui.secParams}</h2>
        <div class="tbl-wrap hud">
          <table class="tbl params">
            <thead><tr>{ui.paramsHead.map((h) => <th>{h}</th>)}</tr></thead>
            <tbody>
              {PARAMS.map((r) => (
                <tr>
                  <td>{r.p[lang]}{r.note && <small>{r.note[lang]}</small>}</td>
                  <td class="mono nw">{r.v[lang]}</td>
                  <td><span class={`st st-${r.s}`}>{ui.statusLabel[r.s]}</span></td>
                  <td class="mono">{r.refs.length ? r.refs.map((k) => <a href={`#ref-${k}`}>[{refNo[k]}]</a>) : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="doc" id="s05">
      <div class="container narrow">
        <h2 class="dh"><span>§ 05</span>{ui.secVV}</h2>
        <p class="body">{ui.vvVerif}</p>
        <ol class="checks">{CHECKS.map((c, i) => <li><span class="ck">T{i + 1}</span><span class="ok">PASS</span><span set:html={S(c[lang])} /></li>)}</ol>
        <p class="body vv-valid hud" set:html={S(ui.vvValid)} />
      </div>
    </section>

    <section class="doc" id="s06">
      <div class="container narrow">
        <h2 class="dh"><span>§ 06</span>{ui.secLimits}</h2>
        <dl class="asm">{ui.assumptions.map(([k, t]) => <div><dt>{k}</dt><dd set:html={S(t)} /></div>)}</dl>
        <ul class="lim">{ui.limits.map((l) => <li>{l}</li>)}</ul>
      </div>
    </section>

    <section class="doc" id="s07">
      <div class="container">
        <h2 class="dh"><span>§ 07</span>{ui.secPassport}</h2>
        <div class="pass-grid">
          <dl class="pass hud">
            <div><dt>{ui.pass.name}</dt><dd>{ui.title} <span class="dim">({otherTitle})</span></dd></div>
            <div><dt>{ui.pass.version}</dt><dd><span class="ver">v{META.version}</span> · {fmtDay(META.updated)}</dd></div>
            <div><dt>{ui.pass.status}</dt><dd>{ui.passStatus}</dd></div>
            <div><dt>{ui.pass.evidence}</dt><dd>{ui.passEvidence}</dd></div>
            <div><dt>{ui.pass.author}</dt><dd>{author.name} · <a href={SITE.orcidUrl} rel="noopener">ORCID {SITE.orcid}</a></dd></div>
            <div><dt>{ui.pass.rights}</dt><dd>{ui.passRights} <a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener">CC BY-NC-ND 4.0</a></dd></div>
            <div><dt>{ui.pass.cite}</dt><dd class="cite">{ui.cite(META.version, author.short)} {ui.avail} {pageUrl}</dd></div>
          </dl>
          <div>
            <p class="hh"><span>LOG</span>{ui.changelog}</p>
            <ol class="clog">{CHANGELOG.map((c) => <li><span class="cl-v">v{c.v}</span><span class="cl-d">{fmtDay(c.date)}</span><p>{c.text[lang]}</p></li>)}</ol>
            <p class="fine">{ui.versioning}</p>
            <p class="fine">{ui.coi}</p>
            <p class="fine">{ui.ai}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="doc doc-last" id="s08">
      <div class="container narrow">
        <h2 class="dh"><span>§ 08</span>{ui.secRefs}</h2>
        <ol class="refs">
          {REF_ORDER.map((k) => {
            const r = REFS[k];
            return <li id={`ref-${k}`}>{r.text} {r.doi ? <a href={`https://doi.org/${r.doi}`} rel="noopener">doi:{r.doi}</a> : r.url ? <a href={r.url} rel="noopener">{r.url}</a> : null}</li>;
          })}
        </ol>
      </div>
    </section>
  </div>
</Base>

<script>
  import { initBodyPowered } from '../scripts/bodypowered-client';
  initBodyPowered();
</script>

<style>
  .bp {
    --void: #07090c; --pn: #0c1118; --pn2: #10161f; --ln: #222c39; --ln2: #33404f;
    --gold: #e9b44c; --gold2: #ffd27a; --cy: #8db0ff; --tx: #e6eaf0; --tx2: #bcc4d0; --mu: #8a93a3;
    --ok: #46c98b; --warn: #e9b44c; --bad: #ff5d5d;
    background: var(--void); color: var(--tx);
  }
  .mono { font-family: var(--font-mono); }
  .nw { white-space: nowrap; }
  /* HUD-рамка: тонка лінія + золоті кутові скоби */
  .hud { position: relative; border: 1px solid var(--ln); background: var(--pn); }
  .hud::before, .hud::after { content: ''; position: absolute; width: 14px; height: 14px; pointer-events: none; z-index: 2; }
  .hud::before { left: -1px; top: -1px; border-left: 2px solid var(--gold); border-top: 2px solid var(--gold); }
  .hud::after { right: -1px; bottom: -1px; border-right: 2px solid var(--gold); border-bottom: 2px solid var(--gold); }
  .hh { display: flex; align-items: center; gap: 10px; margin: 2px 0 10px; font: 500 11px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold); }
  .hh span { padding: 1px 8px 1px 6px; background: var(--gold); color: #0b0d10; font-weight: 600; clip-path: polygon(0 0, 100% 0, calc(100% - 5px) 100%, 0 100%); }
  .hh::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, rgba(233, 180, 76, 0.5), transparent); }

  /* ---------- hero ---------- */
  .hero { position: relative; overflow: hidden; background: radial-gradient(900px 420px at 85% 0%, rgba(233, 180, 76, 0.14), transparent 60%), radial-gradient(700px 400px at 10% 100%, rgba(39, 86, 184, 0.22), transparent 65%), var(--void); border-bottom: 1px solid var(--ln); }
  .lattice, .lab::before { position: absolute; inset: 0; pointer-events: none; background-image: repeating-linear-gradient(60deg, rgba(233, 180, 76, 0.05) 0 1px, transparent 1px 38px), repeating-linear-gradient(-60deg, rgba(233, 180, 76, 0.05) 0 1px, transparent 1px 38px), repeating-linear-gradient(0deg, rgba(141, 176, 255, 0.035) 0 1px, transparent 1px 33px); -webkit-mask-image: radial-gradient(ellipse 85% 85% at 70% 30%, #000 30%, transparent 85%); mask-image: radial-gradient(ellipse 85% 85% at 70% 30%, #000 30%, transparent 85%); }
  .hero-in { position: relative; padding-block: 22px 34px; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 40px; font-size: 14px; color: var(--tx2); }
  .crumbs a:hover { color: #fff; }
  .code { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 6px 0 0; font: 500 12px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .code span:first-child { color: var(--gold); }
  .code-v { text-transform: none; padding: 1px 7px; border: 1px solid rgba(233, 180, 76, 0.5); color: var(--gold2); }
  .code-k { color: var(--cy); }
  .hero-h { font-family: var(--font-sans); margin: 14px 0 0; max-width: 940px; font-size: clamp(30px, 4vw, 52px); line-height: 1.06; letter-spacing: -0.02em; font-weight: 600; color: #fff; }
  .hero-lead { margin: 16px 0 0; max-width: 820px; font-size: 17px; line-height: 1.62; color: var(--tx2); }
  .spec { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 22px 0 0; max-width: 940px; border: 1px solid var(--ln); border-width: 1px 0 0 1px; background: rgba(12, 17, 24, 0.7); }
  @media (max-width: 760px) { .spec { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .spec > div { padding: 10px 14px; border-right: 1px solid var(--ln); border-bottom: 1px solid var(--ln); }
  .spec dt { font: 500 10.5px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--mu); }
  .spec dd { margin: 4px 0 0; font: 500 14px var(--font-mono); color: var(--tx); }
  .warn { margin-top: 18px; max-width: 940px; padding: 12px 16px; background: rgba(233, 180, 76, 0.06); border-color: rgba(233, 180, 76, 0.35); }
  .warn-h { margin: 0 0 4px; font: 600 11.5px var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); }
  .warn p:last-child { margin: 0; font-size: 14.5px; line-height: 1.55; color: #e9dcc0; }

  /* ---------- lab ---------- */
  .lab { position: relative; padding-block: 22px 34px; background: #090c11; border-bottom: 1px solid var(--ln); }
  .lab::before { content: ''; opacity: 0.6; }
  .lab > .container { position: relative; }
  .lab-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .seg { display: inline-flex; gap: 4px; padding: 4px; border: 1px solid var(--ln); background: var(--pn); }
  .seg-b { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; min-height: 48px; padding: 7px 18px 7px 14px; border: 0; background: transparent; color: var(--tx2); cursor: pointer; text-align: left; font: 600 14.5px var(--font-sans); clip-path: polygon(0 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%); }
  .seg-b small { font: 400 11px var(--font-mono); letter-spacing: 0.04em; color: var(--mu); }
  .seg-b[aria-selected='true'] { background: var(--gold); color: #0b0d10; }
  .seg-b[aria-selected='true'] small { color: #3b2d10; }
  .lab-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .lb { min-height: 40px; padding: 0 14px; border: 1px solid var(--ln2); background: var(--pn); color: var(--tx2); font: 500 12px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer; }
  .lb:hover { border-color: var(--gold); color: #fff; }
  .lb[aria-pressed='true'] { border-color: var(--gold); color: var(--gold2); background: rgba(233, 180, 76, 0.08); }
  .lab-grid { display: grid; grid-template-columns: minmax(0, 1fr) 390px; gap: 18px; align-items: start; }
  @media (max-width: 980px) { .lab-grid { grid-template-columns: minmax(0, 1fr); } }
  .scene { min-width: 0; }
  .scene-main { overflow: hidden; padding-top: 22px; background-color: #0a0e14; background-image: linear-gradient(rgba(141, 176, 255, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(141, 176, 255, 0.05) 1px, transparent 1px); background-size: 20px 20px; }
