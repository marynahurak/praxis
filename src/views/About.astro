---
import Base from '../layouts/Base.astro';
import EvidenceHierarchy from '../components/EvidenceHierarchy.astro';
import ConfidenceBadge from '../components/ConfidenceBadge.astro';
import { CONFIDENCE, CONFIDENCE_KEYS, SECTIONS, SECTION_KEYS, SITE, type Lang } from '../config';
import { localePath } from '../utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const author = SITE.author[lang];
const other = lang === 'uk' ? 'en' : 'uk';

const LINKS = {
  cope: 'https://publicationethics.org/',
  icmje: 'https://www.icmje.org/recommendations/',
  helsinki: 'https://www.wma.net/policies-post/wma-declaration-of-helsinki/',
  care: 'https://www.care-statement.org/',
  equator: 'https://www.equator-network.org/',
  ccbync: 'https://creativecommons.org/licenses/by-nc/4.0/',
};

const c = {
  uk: {
    title: 'Про Praxis',
    lead: 'Praxis — незалежна науково-освітня ініціатива, присвячена розвитку доказової практики (evidence-based practice, EBP) та інновацій у протезуванні, ортезуванні й реабілітації. У центрі уваги — трансляційні дослідження, біомеханіка ходи та рухів верхньої кінцівки, об\'єктивне оцінювання ефективності протезних технологій і систематизація рецензованої фахової літератури. Мета Praxis — створити спільний дослідницький простір для фахівців-практиків, науковців, R&D-інженерів та академічної спільноти в Україні й світі.',
    whyTitle: 'Чому Praxis',
    why: 'Слово «праксис» можна трактувати по-різному. У неврології це вища кіркова функція: здатність спланувати й виконати цілеспрямований рух. Для мене Praxis — це усвідомлена дія, у якій теорія нерозривно втілюється в практику заради конкретного результату: момент, коли сухі наукові знання стають реальною клінічною дією, а не сліпим копіюванням чужих шаблонів.',
    whyBy: 'Марина Гурак, засновниця Praxis',
    aimsTitle: 'Мета і завдання',
    aimsIntro: 'Praxis прагне скоротити розрив між опублікованими доказами, інженерними розробками та щоденними клінічними рішеннями. Для цього ініціатива:',
    aims: [
      'критично оцінює дизайн, методологію та обмеження досліджень з урахуванням міжнародних настанов щодо звітування;',
      'аналізує біомеханічні та інженерні механізми, що лежать в основі клінічних ефектів;',
      'оцінює протезні технології за незалежними рецензованими даними, враховуючи, до якого етапу життєвого циклу медичного виробу ці дані належать: стендових випробувань, клінічних досліджень чи постмаркетингового спостереження;',
      'систематизує рецензовану літературу й визначає прогалини в доказах, що потребують подальших досліджень;',
      'формулює практичні висновки для мультидисциплінарної реабілітаційної команди (МДРК);',
      'сприяє діалогу між клініцистами, науковцями та розробниками в Україні й за її межами.',
    ],
    context:
      'Окрему увагу приділено українському клінічному контексту, зокрема реабілітації осіб із втратою кінцівки внаслідок бойової травми та політравми.',
    sectionsTitle: 'Розділи',
    includes: 'Охоплює',
    audienceTitle: 'Для кого',
    audience:
      'Для фахівців-практиків (протезистів-ортезистів, фізичних терапевтів, ерготерапевтів, лікарів фізичної та реабілітаційної медицини, психологів), науковців, біомедичних і реабілітаційних інженерів, R&D-команд, що розробляють медичні вироби, а також магістрантів і аспірантів. Матеріали розраховано на читача з базовою клінічною або інженерною підготовкою: вони не пояснюють елементарних понять, а зосереджуються на біомеханіці, методології досліджень і клінічних рішеннях. Статті публікуються українською мовою з англійськими перекладами.',
    policyTitle: 'Редакційна політика',
    policy: [
      ['Аналітичний синтез', 'Кожен матеріал — оригінальний аналітичний синтез, а не переклад чи переказ першоджерела. Цитати й запозичені формулювання позначено та супроводжено посиланнями.'],
      ['Верифікація фактів', 'Кожне фактичне твердження (результати, обсяг вибірки, бібліографічні дані) звірено з першоджерелом. Твердження, які неможливо верифікувати, не публікуються. Вторинне цитування позначено явно («за оглядом…»).'],
      ['Розмежування даних і міркувань', 'Механістичні міркування з першопринципів допустимі, але завжди позначені як такі й відокремлені від емпіричних даних.'],
      ['Незалежність', 'Praxis не має комерційного фінансування, не публікує реклами й не отримує винагороди за згадування продуктів. Технології оцінюються за кінематичними та кінетичними параметрами, масою, кількістю ступенів свободи й рецензованими клінічними результатами. Матеріали виробників використовуються лише як джерело технічних характеристик і позначаються як такі; дослідження, автори яких пов\'язані з виробником, також позначаються.'],
      ['Відкритість до діалогу', 'Praxis відкритий до наукового діалогу з клініцистами, дослідниками й розробниками, зокрема з представниками індустрії. Обґрунтовані заперечення, нові дані та запити на виправлення розглядаються й за потреби враховуються з позначенням дати оновлення статті.'],
      ['Двомовна термінологія', 'Під час першої згадки технічні терміни подаються українською з англійським відповідником, що дає змогу звірити текст із першоджерелом.'],
    ],
    evidenceTitle: 'Оцінювання доказів',
    evidenceText:
      'Кожне ключове твердження співвіднесено з рівнем ієрархії доказів Praxis. Якість досліджень оцінюється з урахуванням міжнародних настанов щодо звітування, зібраних мережею EQUATOR: зокрема CONSORT для рандомізованих досліджень, STROBE для обсерваційних досліджень і PRISMA для систематичних оглядів.',
    confidenceTitle: 'Рівні впевненості',
    structureTitle: 'Структура статті',
    structure: [
      'Вступ: біомеханічний парадокс, неочікуваний результат дослідження або клінічна дилема.',
      'Методологія та механіка: дизайн дослідження, фізичні механізми, властивості матеріалів.',
      'Критичний аудит: ключові результати з точними показниками та обмеженнями.',
      'Висновки для МДРК: практичні рекомендації для мультидисциплінарної команди.',
      'Питання до спільноти.',
      'Список джерел, декларація конфлікту інтересів і рекомендація щодо цитування.',
    ],
    ethicsTitle: 'Етика публікацій та академічна доброчесність',
    ethicsIntro:
      'Praxis керується міжнародними принципами етики наукових публікацій. Ініціатива не є членом зазначених організацій; їхні документи слугують орієнтиром редакційної практики.',
    ethics: [
      ['COPE', LINKS.cope, 'Основні принципи (Core Practices) Комітету з етики публікацій (Committee on Publication Ethics, COPE) щодо авторства, конфлікту інтересів, виправлень, запобігання плагіату та прозорості редакційних процесів.'],
      ['ICMJE', LINKS.icmje, 'Рекомендації Міжнародного комітету редакторів медичних журналів (International Committee of Medical Journal Editors) щодо декларування конфлікту інтересів і відповідальності автора за зміст.'],
      ['Гельсінська декларація', LINKS.helsinki, 'Етичні принципи Всесвітньої медичної асоціації (World Medical Association, WMA) щодо медичних досліджень за участю людей, зокрема захисту приватності й конфіденційності персональних даних.'],
      ['CARE', LINKS.care, 'Настанови CARE щодо описів клінічних випадків: реальні випадки публікуються лише за письмової інформованої згоди пацієнта та в знеособленому вигляді; змодельовані навчальні випадки позначаються як такі.'],
    ],
    coiTitle: 'Конфлікт інтересів',
    coi: 'Кожна стаття містить декларацію конфлікту інтересів. За відсутності конфлікту це зазначається явно.',
    correctionsTitle: 'Виправлення',
    corrections: 'Виявлені помилки виправляються якнайшвидше. Суттєві виправлення позначаються датою оновлення статті.',
    aiTitle: 'Використання інструментів штучного інтелекту',
    ai: 'Praxis розкриває використання інструментів штучного інтелекту відповідно до позиції COPE щодо авторства та інструментів ШІ й рекомендацій ICMJE. Ці інструменти застосовуються для пошуку й верифікації джерел, мовного редагування, перекладу та розроблення сайту. Усі матеріали перевіряє та затверджує авторка, яка несе повну відповідальність за їхній зміст. Інструменти штучного інтелекту не є авторами.',
    copyrightTitle: 'Авторське право та зображення',
    copyright: 'Використовуються лише власні ілюстрації або матеріали, поширювані за відкритими ліцензіями, із зазначенням авторства. Praxis не розміщує копій підручників, каталогів чи інших матеріалів, захищених авторським правом.',
    authorTitle: 'Авторка',
    authorText: [
      'Марина Гурак — засновниця та редакторка Praxis, протезистка-ортезистка, ISPO Associate Prosthetist (2025; освітня програма Human Study e.V. / МКЧХ, акредитована ISPO). Працює у відділенні протезування верхніх кінцівок Superhumans War Trauma Center.',
      'Магістрантка освітньої програми «Протезування та ортезування» Харківського національного медичного університету. Має ступінь магістра з фізичної терапії (Національний університет фізичного виховання і спорту України) і ступінь бакалавра за спеціальністю «Фізична терапія, ерготерапія» (КПІ ім. Ігоря Сікорського). Проходила клінічні стажування в Німеччині (BG Unfallklinik Murnau) та США (Міннеаполіс).',
    ],
    licenseTitle: 'Ліцензія та цитування',
    license: [
      'Тексти статей поширюються за ліцензією Creative Commons «Зазначення авторства — Некомерційна» 4.0 Міжнародна (CC BY-NC 4.0): їх можна поширювати й адаптувати із зазначенням авторки та Praxis, але не з комерційною метою.',
      'Вихідний код сайту поширюється за ліцензією MIT. Ілюстрації та таблиці третіх сторін зберігають ліцензії своїх правовласників.',
    ],
    citeTitle: 'Як цитувати статтю',
    citeExample: `${author.short} Назва статті. Praxis. Рік. Доступно за посиланням: URL`,
    disclaimerTitle: 'Застереження',
    disclaimer:
      'Матеріали Praxis мають освітній характер і не замінюють індивідуальної клінічної консультації чи рішень лікувальної команди.',
    contactTitle: 'Контакти та співпраця',
    contact: 'Praxis відкритий до наукової співпраці з клініками, університетами та R&D-командами. Пропозиції тем, виправлення, запитання й запити щодо співпраці надсилайте через спільноту Praxis у Telegram або LinkedIn.',
    repo: 'Вихідний код сайту',
  },
  en: {
    title: 'About Praxis',
    lead: 'Praxis is an independent scientific and educational initiative dedicated to advancing evidence-based practice (EBP) and innovation in prosthetics, orthotics and rehabilitation. It focuses on translational research, the biomechanics of gait and upper-limb movement, the objective evaluation of prosthetic technologies and the structured synthesis of peer-reviewed literature. Its mission is to foster a shared research environment for clinicians, academic researchers, R&D engineers and the international rehabilitation community.',
    whyTitle: 'Why Praxis',
    why: 'The word praxis can be read in many ways. In neurology, it is a higher cortical function: the ability to plan and carry out purposeful movement. To me, Praxis is deliberate action in which theory is inseparably carried into practice for the sake of a concrete result: the moment when dry scientific knowledge becomes real clinical action rather than the blind copying of other people’s templates.',
    whyBy: 'Maryna Hurak, founder of Praxis',
    aimsTitle: 'Aims and scope',
    aimsIntro: 'Praxis aims to narrow the gap between published evidence, engineering development and everyday clinical decision-making. To this end, it:',
    aims: [
      'critically appraises study design, methodology and limitations with reference to international reporting guidelines;',
      'analyses the biomechanical and engineering mechanisms underlying clinical effects;',
      'evaluates prosthetic technologies on independent, peer-reviewed evidence, taking into account the stage of the medical device life cycle from which the data originate: bench testing, clinical investigation or post-market surveillance;',
      'synthesises peer-reviewed literature and identifies evidence gaps that warrant further research;',
      'derives practical implications for the multidisciplinary rehabilitation team (MDT);',
      'fosters dialogue between clinicians, researchers and developers in Ukraine and internationally.',
    ],
    context:
      'Particular attention is given to the Ukrainian clinical context, including the rehabilitation of people with limb loss resulting from combat injuries and polytrauma.',
    sectionsTitle: 'Sections',
    includes: 'Covers',
    audienceTitle: 'Readership',
    audience:
      'Clinicians (prosthetists-orthotists, physical therapists, occupational therapists, physical and rehabilitation medicine physicians and psychologists), researchers, biomedical and rehabilitation engineers, R&D teams developing medical devices, and graduate students. Content assumes basic clinical or engineering training: rather than explaining elementary concepts, it focuses on biomechanics, research methodology and clinical decision-making. Articles are published in Ukrainian with English translations.',
    policyTitle: 'Editorial policy',
    policy: [
      ['Analytical synthesis', 'Every piece is an original analytical synthesis rather than a translation or paraphrase of a source. Quotations and borrowed wording are marked and referenced.'],
      ['Fact verification', 'Every factual claim (outcomes, sample sizes, bibliographic data) is checked against the primary source. Claims that cannot be verified are not published. Secondary citation is indicated explicitly (“as cited in…”).'],
      ['Data versus reasoning', 'First-principles mechanistic reasoning is permitted but is always labelled as such and kept separate from empirical data.'],
      ['Independence', 'Praxis receives no commercial funding, carries no advertising and accepts no payment for mentioning products. Technologies are assessed on kinematic and kinetic parameters, mass, degrees of freedom and peer-reviewed clinical outcomes. Manufacturer materials are used only as a source of technical specifications and are labelled as such; studies whose authors are affiliated with a manufacturer are also identified.'],
      ['Open dialogue', 'Praxis welcomes scholarly dialogue with clinicians, researchers and developers, including industry. Substantiated objections, new data and requests for correction are considered and, where warranted, incorporated, with the article’s update date indicated.'],
      ['Bilingual terminology', 'Technical terms are given in Ukrainian with their English equivalents on first use, so that the text can be checked against the primary source.'],
    ],
    evidenceTitle: 'Appraisal of evidence',
    evidenceText:
      'Every key claim is mapped to a level of the Praxis evidence hierarchy. Study quality is appraised with reference to international reporting guidelines collated by the EQUATOR Network, including CONSORT for randomised trials, STROBE for observational studies and PRISMA for systematic reviews.',
    confidenceTitle: 'Confidence levels',
    structureTitle: 'Article structure',
    structure: [
      'Introduction: a biomechanical paradox, an unexpected research finding or a clinical dilemma.',
      'Methodology and mechanics: study design, physical mechanisms, material properties.',
      'Critical appraisal: key findings with exact outcomes and limitations.',
      'Implications for the MDT: practical recommendations for the multidisciplinary team.',
      'Questions for the community.',
      'References, a conflict-of-interest statement and a suggested citation.',
    ],
    ethicsTitle: 'Publication ethics and academic integrity',
    ethicsIntro:
      'Praxis follows international principles of publication ethics. It is not a member of the organisations listed below; their guidance serves as a reference for editorial practice.',
    ethics: [
      ['COPE', LINKS.cope, 'The Core Practices of the Committee on Publication Ethics (COPE) on authorship, conflicts of interest, corrections, plagiarism prevention and transparency of editorial processes.'],
      ['ICMJE', LINKS.icmje, 'The Recommendations of the International Committee of Medical Journal Editors on disclosure of conflicts of interest and authors’ responsibility for content.'],
      ['Declaration of Helsinki', LINKS.helsinki, 'The ethical principles of the World Medical Association (WMA) for medical research involving human participants, including protection of privacy and confidentiality of personal data.'],
      ['CARE', LINKS.care, 'The CARE guidelines for case reports: real cases are published only with the patient’s written informed consent and in de-identified form; simulated teaching cases are labelled as such.'],
    ],
    coiTitle: 'Conflicts of interest',
    coi: 'Every article includes a conflict-of-interest statement. Where no conflict exists, this is stated explicitly.',
    correctionsTitle: 'Corrections',
    corrections: 'Errors are corrected promptly once identified. Substantive corrections are indicated by the article’s update date.',
    aiTitle: 'Use of artificial intelligence tools',
    ai: 'In line with the COPE position on authorship and AI tools and the ICMJE Recommendations, Praxis discloses its use of such tools. They are used to support source retrieval and verification, language editing, translation and website development. All content is reviewed and approved by the author, who takes full responsibility for it. AI tools are not credited as authors.',
    copyrightTitle: 'Copyright and images',
    copyright: 'Only original illustrations or openly licensed material with attribution are used. Praxis does not host copies of textbooks, catalogues or other copyrighted material.',
    authorTitle: 'Author',
    authorText: [
      'Maryna Hurak is the founder and editor of Praxis. She is a prosthetist-orthotist and ISPO Associate Prosthetist (2025; Human Study e.V./ICRC programme accredited by ISPO) and works in the Upper Limb Prosthetics Department at Superhumans War Trauma Center.',
      'She is completing an MSc in Prosthetics and Orthotics at Kharkiv National Medical University. She holds an MSc in Physical Therapy from the National University of Ukraine on Physical Education and Sport and a BSc in Physical Therapy and Occupational Therapy from Igor Sikorsky Kyiv Polytechnic Institute, and has completed clinical placements in Germany (BG Unfallklinik Murnau) and the United States (Minneapolis).',
    ],
    licenseTitle: 'Licence and citation',
    license: [
      'Article texts are licensed under Creative Commons Attribution-NonCommercial 4.0 International (CC BY-NC 4.0): they may be shared and adapted with attribution to the author and Praxis, but not for commercial purposes.',
      'The site source code is available under the MIT licence. Third-party figures and tables retain the licences of their rights holders.',
    ],
    citeTitle: 'How to cite an article',
    citeExample: `${author.short} Article title. Praxis. Year. Available from: URL`,
    disclaimerTitle: 'Disclaimer',
    disclaimer: 'Praxis content is educational and does not replace individual clinical advice or the decisions of the treating team.',
    contactTitle: 'Contact and collaboration',
    contact: 'Praxis is open to scientific collaboration with clinics, universities and R&D teams. Topic suggestions, corrections, questions and collaboration enquiries are welcome via the Praxis community on Telegram or via LinkedIn.',
    repo: 'Site source code',
  },
}[lang];
---

<Base lang={lang} title={c.title} description={c.lead} altLangHref={localePath(other, 'about/')}>
  <div class="container page">
    <header class="intro">
      <p class="eyebrow">Praxis</p>
      <h1>{c.title}</h1>
      <p class="lead">{c.lead}</p>
    </header>

    <section id="why-praxis" class="why" aria-labelledby="why-h">
      <h2 id="why-h" class="why-h">{c.whyTitle}</h2>
      <blockquote class="why-q">
        <p>{c.why}</p>
        <footer>— {c.whyBy}</footer>
      </blockquote>
    </section>

    <div class="grid">
      <div class="col-main">
        <section aria-labelledby="aims-h">
          <h2 id="aims-h">{c.aimsTitle}</h2>
          <p>{c.aimsIntro}</p>
          <ul class="plain">
            {c.aims.map((a) => <li>{a}</li>)}
          </ul>
          <p>{c.context}</p>
        </section>

        <section aria-labelledby="sections-h">
          <h2 id="sections-h">{c.sectionsTitle}</h2>
          <ul class="numbered">
            {
              SECTION_KEYS.map((k) => (
                <li>
                  <span class="mono n">{SECTIONS[k].num}</span>
                  <div>
                    <h3>
                      <a href={localePath(lang, `sections/${k}/`)}>{SECTIONS[k][lang].title}</a>
                    </h3>
                    <p>{SECTIONS[k][lang].desc}</p>
                    <p class="subs">
                      {c.includes}: {SECTIONS[k][lang].subs.join(' · ')}
                    </p>
                  </div>
                </li>
