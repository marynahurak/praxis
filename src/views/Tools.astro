---
import Base from '../layouts/Base.astro';
import { type Lang } from '../config';
import { localePath } from '../utils';
import myomap from '../data/myomap.json';
import { META as bpMeta } from '../lib/bodypowered/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';

const c = {
  uk: {
    title: 'Інструменти',
    lead: 'Інтерактивні клінічні інструменти Praxis. Кожен інструмент має позначений рівень доказів, перелік джерел і дату останнього оновлення.',
    open: 'Відкрити інструмент →',
    version: 'Версія',
    tools: [
      {
        href: 'tools/myotesting-map/',
        tag: 'Протезування верхньої кінцівки',
        title: 'Атлас локалізації міоточок та конфігурації sEMG-електродів',
        desc: 'Клініко-інженерний довідник для топографічної локалізації цільових м\'язових черевців, вибору фізіологічно конгруентних патернів м\'язової активації та розміщення поверхневих електроміографічних (sEMG) електродів у міоелектричному протезуванні верхньої кінцівки.',
        ev: 'Низька–помірна впевненість',
        version: myomap.meta.version,
      },
      {
        href: 'tools/body-powered-simulator/',
        tag: 'Протезування верхньої кінцівки · Інженерія',
        title: 'Симулятор тягової системи протеза верхньої кінцівки',
        desc: 'Інтерактивна модель тягового протеза: хід троса від рухів плечового поясу, тертя в оболонці Боудена за рівнянням Ейлера — Ейтельвейна, зусилля на відкриття гака й ризик утоми. Режими для пацієнта й протезиста.',
        ev: 'Механістична модель · параметри з літератури',
        version: bpMeta.version,
      },
    ],
  },
  en: {
    title: 'Tools',
    lead: 'Interactive clinical tools from Praxis. Each tool states its level of evidence, its references and the date of its last update.',
    open: 'Open the tool →',
    version: 'Version',
    tools: [
      {
        href: 'tools/myotesting-map/',
        tag: 'Upper limb prosthetics',
        title: 'Myosite localisation and sEMG electrode configuration atlas',
        desc: 'A clinical-engineering reference for the topographic localisation of target muscle bellies, the selection of physiologically congruent muscle activation patterns, and the placement of surface electromyographic (sEMG) electrodes in upper-limb myoelectric prosthetics.',
        ev: 'Low to moderate confidence',
        version: myomap.meta.version,
      },
      {
        href: 'tools/body-powered-simulator/',
        tag: 'Upper limb prosthetics · Engineering',
        title: 'Body-powered upper-limb prosthesis control simulator',
        desc: 'An interactive model of a body-powered prosthesis: cable excursion from shoulder-girdle movement, friction in the Bowden housing by the Euler–Eytelwein equation, the force to open the hook and the risk of fatigue. Modes for patients and prosthetists.',
        ev: 'Mechanistic model · parameters from the literature',
        version: bpMeta.version,
      },
    ],
  },
}[lang];
---

<Base lang={lang} title={c.title} description={c.lead} altLangHref={localePath(other, 'tools/')}>
  <div class="container page">
    <h1 class="h-page">{c.title}</h1>
    <p class="lead-muted">{c.lead}</p>
    <ul class="list">
      {
        c.tools.map((tool) => (
          <li>
            <a class="tool card" href={localePath(lang, tool.href)}>
              <p class="mono tag">{tool.tag}</p>
              <h2>{tool.title}</h2>
              <p class="desc">{tool.desc}</p>
              <p class="meta mono">
                {tool.ev} · {c.version} {tool.version}
              </p>
              <span class="go">{c.open}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>

<style>
  .page {
    padding-block: 40px 80px;
  }
  .h-page {
    margin: 0;
    font-size: clamp(34px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 600;
  }
  .lead-muted {
    max-width: 720px;
  }
  .list {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 18px;
  }
  .tool {
    display: block;
    height: 100%;
    padding: 22px 24px;
    text-decoration: none;
    color: var(--text-2);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .tool:hover {
    border-color: var(--accent);
    box-shadow: 0 2px 10px rgba(39, 86, 184, 0.1);
  }
  .tag {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    margin: 0 0 8px;
    font-size: 24px;
    line-height: 1.25;
    color: var(--ink);
  }
  .desc {
    margin: 0 0 12px;
    line-height: 1.55;
  }
  .meta {
    margin: 0 0 12px;
    font-size: 12.5px;
    color: var(--muted);
  }
  .go {
    font-weight: 600;
    color: var(--accent);
  }
</style>
