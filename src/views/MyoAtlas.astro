---
// Повноекранна інтерактивна мапа «Атласу локалізації міоточок та конфігурації sEMG-електродів».
// Тексти й дані — src/lib/myomap.ts та src/data/myomap.json; поведінка — src/scripts/myomap-client.ts.
// Анатомія: BodyParts3D © DBCLS, CC BY 4.0 (атрибуція обов'язкова — див. рядок у нижній панелі мапи).
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { type Lang } from '../config';
import { localePath, url } from '../utils';
import { D, GEO, SEC, LEVELS, MODES, START_LEVEL, START_VIEW, ABBR, LV_SHORT, VIEW_SHORT, SEC_SHORT_L, tr, getUi, orientFor, roleOf, isTmr, buildClientData, elSvg } from '../lib/myomap';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other = lang === 'uk' ? 'en' : 'uk';
const tx = tr(lang);
const ui = getUi(lang);
const ORIENT = orientFor(ui);
const guideHref = localePath(lang, 'tools/myotesting-map/');
const clientData = buildClientData(lang);
const SHORT: Record<string, { uk: string; en: string }> = {
  int: { uk: 'Інтегрований', en: 'Integrated' },
  suction: { uk: 'Вакуумний', en: 'Suction' },
  remote: { uk: 'Віддалений', en: 'Remote' },
  dome: { uk: 'Куполи', en: 'Domes' },
};
const ROLE_KEYS = ['primary', 'secondary', 'caution', 'conditional', 'deep', 'context'];
// шкала: найбільший «круглий» відрізок, що займає не більше 28% ширини схеми
const scaleBar = (ppm: number, w: number) => {
  let mm = 10;
  for (const o of [10, 20, 50, 100]) if ((o * ppm) / 1000 <= 0.28 * w) mm = o;
  return { mm, px: (mm * ppm) / 1000 };
};
const roleLegend = ROLE_KEYS.map((r) => ({ r, label: tx(D.roles[r]) }));
const SEC_SHORT = SEC_SHORT_L[lang];
---

<Base lang={lang} title={`${ui.title} — ${ui.mapSuffix}`} description={ui.lead} altLangHref={localePath(other, 'tools/myotesting-map/atlas/')} bare>
  <script type="application/json" id="mm-data" set:html={JSON.stringify(clientData)} />

  <div class="mm app" data-level={START_LEVEL} data-view={START_VIEW} data-mode="direct" data-weak="on" data-labels="off">
    <header class="appbar">
      <a class="brand" href={localePath(lang)} aria-label="Praxis"><Logo size={30} /></a>
      <a class="back" href={guideHref}><span aria-hidden="true">←</span> <span class="back-t">{ui.guideBack}</span></a>
      <h1 class="app-title">{ui.atlasShort} <span class="ver">v{D.meta.version}</span></h1>
      <p class="notice">{ui.notice} <a href={`${guideHref}#scope`}>{ui.noticeMore}</a></p>
      <a class="lang-sw" href={localePath(other, 'tools/myotesting-map/atlas/')} hreflang={other} lang={other}>{other === 'en' ? 'EN' : 'УКР'}</a>
    </header>

    <nav class="toolbar" aria-label={ui.mapNav}>
      <div class="tb-m">
        <select data-m="level" aria-label={ui.level}>{LEVELS.map((lv) => <option value={lv} selected={lv === START_LEVEL}>{LV_SHORT[lv][lang]}</option>)}</select>
        <select data-m="view" aria-label={ui.view}><option value={START_VIEW}>{VIEW_SHORT[START_VIEW][lang]}</option></select>
        <select data-m="mode" aria-label={ui.mode}>{MODES.map((m) => <option value={m}>{tx(D.modes[m].label)}</option>)}</select>
      </div>
      <div class="seg" role="group" aria-label={ui.level}>
        {LEVELS.map((lv) => <button type="button" class="seg-btn" data-set-level={lv} aria-pressed={lv === START_LEVEL ? 'true' : 'false'} title={tx(D.levels[lv].title)}>{LV_SHORT[lv][lang]}</button>)}
      </div>
      <div class="seg" role="group" aria-label={ui.view}>
        {LEVELS.map((lv) => [
          ...D.levels[lv].views.map((v: any) => <button type="button" class="seg-btn vbtn" data-lv={lv} data-set-view={v.id} aria-pressed={v.id === START_VIEW ? 'true' : 'false'} title={tx(v.label)}>{VIEW_SHORT[v.id][lang]}</button>),
          ...(D.levels[lv].sections.length ? [<button type="button" class="seg-btn vbtn" data-lv={lv} data-set-view={D.levels[lv].sections[0].id} data-sec-btn="1" aria-pressed="false" title={ui.section}>{SEC_SHORT}</button>] : []),
        ])}
      </div>
      <div class="seclevels" role="group" aria-label={ui.sectionLevel}>
        {LEVELS.map((lv) => D.levels[lv].sections.map((s: any) => <button type="button" class="chip-btn" data-lv={lv} data-set-view={s.id} aria-pressed="false">{tx(s.label)}</button>))}
      </div>
      <div class="seg" role="group" aria-label={ui.mode}>
        {MODES.map((m) => <button type="button" class="seg-btn" data-set-mode={m} aria-pressed={m === 'direct' ? 'true' : 'false'}>{tx(D.modes[m].label)}</button>)}
      </div>
    </nav>

    <div class="work">
      <figure class="fig">
        <p class="armed-hint" aria-live="polite"></p>
        <div class="tip" aria-hidden="true"></div>
        <div class="stage-area">
          {LEVELS.map((lv) =>
            D.levels[lv].views.map((v: any) => {
              const g = GEO[v.id];
              const muscles = g.structs.filter((s: any) => s.kind === 'muscle');
              return (
                <div class="stage-wrap" data-stage={v.id} hidden={v.id !== START_VIEW}>
                  <div class="orient"><span>← {ORIENT[v.id][0]}</span><span>{tx(v.label)}</span><span>{ORIENT[v.id][1]} →</span></div>
                  <svg class="stage" viewBox={`0 0 ${g.w} ${g.h}`} data-view={v.id} role="group" aria-label={`${tx(D.levels[lv].title)}: ${tx(v.label)}`}>
                    <defs>
                      <pattern id={`h-${v.id}`} width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="7" height="7" class="hb" /><line x1="0" y1="0" x2="0" y2="7" class="hl" /></pattern>
                      <pattern id={`w-${v.id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><line x1="0" y1="0" x2="0" y2="6" class="wl" /></pattern>
                    </defs>
                    <path class="skin" d={g.skin} />
                    <image href={url(`myomap/${v.id}.webp`)} width={g.w} height={g.h} class="shade" />
                    <g class="structs">
                      {g.structs.map((s: any) =>
                        s.kind === 'bone' ? (
                          <path class="bone hit" data-bone={s.key} d={s.d} fill-rule="evenodd" />
                        ) : s.kind === 'ctx' ? (
                          <path class="ctx" d={s.d} fill-rule="evenodd" />
                        ) : (
                          <path class={`mus hit${s.schematic ? ' schem' : ''}`} data-key={s.key} data-role={roleOf(lv, s.key)} d={s.d} fill-rule="evenodd" tabindex="0" role="button" aria-label={tx(D.muscles[s.key]?.name)} />
                        ),
                      )}
                    </g>
                    <g class="tz-g" aria-hidden="true">{muscles.filter((s: any) => s.t).map((s: any) => <path class="tz" data-tz={s.key} d={s.t} fill-rule="evenodd" />)}</g>
                    <g class="weak-g" aria-hidden="true">
                      {muscles.filter((s: any) => s.t).map((s: any) => <path d={s.t} fill={`url(#w-${v.id})`} fill-rule="evenodd" />)}
                      {g.structs.filter((s: any) => s.kind === 'bone').map((s: any) => <path d={s.d} fill={`url(#w-${v.id})`} fill-rule="evenodd" />)}
                    </g>
                    <g class="tmr-g" aria-hidden="true">{muscles.filter((s: any) => isTmr(lv, s.key)).map((s: any) => <path d={s.d} fill={`url(#h-${v.id})`} class="tmrp" fill-rule="evenodd" />)}</g>
                    <g class="lbl-g" aria-hidden="true">{muscles.filter((s: any) => (s.belly_cm2 ?? 0) > 1.2).map((s: any) => <text x={s.site[0]} y={s.site[1]} class="lbl">{ABBR[s.key]}</text>)}</g>
                    <g class="scalebar" aria-hidden="true">{(() => { const b = scaleBar(g.ppm, g.w); return <><path d={`M14 ${g.h - 16}v6h${b.px.toFixed(1)}v-6`} /><text x={14 + b.px / 2} y={g.h - 20}>{b.mm} {ui.mm}</text></>; })()}</g>
                    <g class="els" />
                  </svg>
                </div>
              );
            }),
          )}
          {LEVELS.map((lv) =>
            D.levels[lv].sections.map((sv: any) => {
              const g = SEC[sv.id];
              const left = lv === 'ph' ? ui.radial : ui.sideL;
              const right = lv === 'ph' ? ui.ulnar : ui.sideM;
              return (
                <div class="stage-wrap" data-stage={sv.id} hidden>
                  <div class="orient"><span>← {left}</span><span>{ui.section}: {tx(sv.label)}</span><span>{right} →</span></div>
                  <svg class="stage sec" viewBox={`-32 -32 ${g.w + 64} ${g.h + 64}`} data-view={sv.id} role="group" aria-label={`${ui.section}: ${tx(sv.label)}`}>
                    <defs><pattern id={`w-${sv.id}`} width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(-45)"><line x1="0" y1="0" x2="0" y2="6" class="wl" /></pattern></defs>
                    <path class="skin sec-skin" d={g.skin} />
                    <g class="structs">
                      {g.structs.map((s: any) =>
                        s.kind === 'bone' ? (
                          <path class="bone hit flat" data-bone={s.key} d={s.d} fill-rule="evenodd" />
                        ) : s.kind === 'ctx' ? (
                          <path class="ctx flat" d={s.d} fill-rule="evenodd" />
                        ) : (
                          <path class={`mus hit flat${s.tendon ? ' tendon' : ''}`} data-key={s.key} data-role={roleOf(lv, s.key)} d={s.d} fill-rule="evenodd" tabindex="0" role="button" aria-label={tx(D.muscles[s.key]?.name)} />
                        ),
                      )}
                    </g>
                    <g class="weak-g" aria-hidden="true">{g.structs.filter((s: any) => s.tendon || s.kind === 'bone').map((s: any) => <path d={s.d} fill={`url(#w-${sv.id})`} fill-rule="evenodd" />)}</g>
                    <g class="scalebar" aria-hidden="true">{(() => { const b = scaleBar(g.ppm, g.w); return <><path d={`M-18 ${g.h + 18}v6h${b.px.toFixed(1)}v-6`} /><text x={-18 + b.px / 2} y={g.h + 14}>{b.mm} {ui.mm}</text></>; })()}</g>
                    <g class="lbl-g on" aria-hidden="true">{g.structs.filter((s: any) => s.kind === 'muscle' && !s.tendon && (s.area_cm2 ?? 0) > (lv === 'ph' ? 0.15 : 0.45)).map((s: any) => <text x={s.site[0]} y={s.site[1]} class="lbl sl">{ABBR[s.key]}</text>)}</g>
                    <g class="els" />
                  </svg>
                  <p class="sec-cap">{(ui.fromBelow as Record<string, string>)[lv]}</p>
                </div>
              );
            }),
          )}
        </div>
        <div class="figbar">
          <div class="toggles">
            <label><input type="checkbox" data-toggle="weak" checked /> {ui.weak}</label>
            <label><input type="checkbox" data-toggle="labels" /> {ui.labels}</label>
            <label><input type="checkbox" data-toggle="align" checked /> {ui.align}</label>
          </div>
          <p class="credit"><a href={`${guideHref}#copyright`}>{ui.copyShort} · {ui.licName}</a> · {ui.credit} · <a href={`${guideHref}#anatomy-source`}>{ui.sourceTitle}</a></p>
        </div>
      </figure>

      <aside class="panel" data-open="false">
        <button type="button" class="sheet-handle" aria-expanded="false">
          <span class="grip" aria-hidden="true"></span>
          <span class="sheet-sum">{tx(D.levels[START_LEVEL].title)}</span>
          <span class="chev" aria-hidden="true">▴</span>
        </button>
        <div class="palette">
          <div class="pal-head"><span class="ctl-label">{ui.palette}</span><span class="pal-hint">{ui.paletteHint}</span></div>
          <div class="pal-list">
            {D.electrodes.map((e: any, i: number) => (
              <button type="button" class="pal-item" data-el={e.id} aria-pressed={i === 0 ? 'true' : 'false'} title={`${tx(e.name)} — ${e.example}. ${tx(e.note)}`}>
                <span class="pal-svg" set:html={elSvg(e)} />
                <span class="pal-txt">
                  <span class="pal-name"><span class="n-full">{tx(e.name)}</span><span class="n-short">{SHORT[e.id]?.[lang] ?? tx(e.name)}</span></span>
                  <span class="pal-ex">{e.example}</span>
                  <span class="pal-ex dim">{e.dims ? `${e.w} × ${e.h} ${ui.mm}` : lang === 'uk' ? 'контур схематичний' : 'schematic outline'}</span>
                </span>
              </button>
            ))}
          </div>
          <div class="pal-actions">
            <button type="button" class="mini-btn" data-act="ring">{ui.ring}</button>
          </div>
        </div>

        <div class="legend">
          <ul class="lg">{roleLegend.map((x) => <li class="lg-role"><span class={`sw sw-${x.r}`} aria-hidden="true" />{x.label}</li>)}<li class="lg-weak"><span class="sw sw-weak" aria-hidden="true" />{ui.weak}</li><li class="lg-tmr"><span class="sw sw-tmr" aria-hidden="true" />TMR: {ui.tmrHatch}</li></ul>
        </div>
        <div class="panel-body">
          <div class="legend legend-m">
            <ul class="lg">{roleLegend.map((x) => <li class="lg-role"><span class={`sw sw-${x.r}`} aria-hidden="true" />{x.label}</li>)}<li class="lg-weak"><span class="sw sw-weak" aria-hidden="true" />{ui.weak}</li><li class="lg-tmr"><span class="sw sw-tmr" aria-hidden="true" />TMR: {ui.tmrHatch}</li></ul>
          </div>
          <section class="fb card-x" hidden aria-live="polite">
            <div class="fb-head"><h2 class="card-h fb-title">{ui.fbTitle}</h2><span class="fb-badge"></span></div>
            <ul class="fb-list"></ul>
            <div class="fb-actions">
              <button type="button" class="ic-btn" data-el-act="rotl" title={ui.rotL} aria-label={ui.rotL}>⟲</button>
              <button type="button" class="ic-btn" data-el-act="rotr" title={ui.rotR} aria-label={ui.rotR}>⟳</button>
              <button type="button" class="mini-btn" data-el-act="align">{ui.alignBtn}</button>
              <button type="button" class="mini-btn" data-el-act="site">{ui.siteBtn}</button>
              <button type="button" class="mini-btn danger" data-el-act="del">{ui.del}</button>
              <button type="button" class="mini-btn danger" data-act="clear">{ui.clear}</button>
            </div>
            <p class="fb-pair"></p>
            <p class="fb-note">{ui.fbNote}</p>
          </section>

          {LEVELS.map((lv) => (
            <article class="card-x card-intro" data-intro={lv} hidden={lv !== START_LEVEL}>
              <h2 class="card-h">{tx(D.levels[lv].title)}</h2>
              <p class="notice-m">{ui.notice} <a href={`${guideHref}#scope`}>{ui.noticeMore}</a></p>
              <p>{tx(D.levels[lv].intro)}</p>
              {MODES.map((m) => <p class="note" data-for={m}><span class="note-k">{tx(D.modes[m].label)}</span>{tx(D.levels[lv].modeNotes[m])} <a href={`${guideHref}#modes`}>{ui.aboutModes} →</a></p>)}
              <h3>{ui.levelPit}</h3>
              <ul class="pit">{D.levels[lv].pitfalls.map((p: any) => <li>{tx(p)}</li>)}</ul>
              <details class="howto">
                <summary>{ui.howTitle}</summary>
                <ol>{ui.how.map((h: string) => <li>{h}</li>)}</ol>
              </details>
              <p class="pick">{ui.pick}</p>
            </article>
          ))}
          {Object.entries(D.muscles).map(([k, m]: [string, any]) => (
            <article class="card-x card-m" data-card={k} hidden>
              <p class="role-badge"></p>
              <h2 class="card-h">{tx(m.name)}{m.syn && <span class="syn"> ({tx(m.syn)})</span>}</h2>
              <p class="latin">{m.latin}{lang === 'uk' && <span class="en-n"> · {m.name.en}</span>}</p>
              {m.schematic && <p class="schem-note">{ui.schematic}</p>}
              <div class="card-actions">
                <button type="button" class="mini-btn place-here" data-place={k}>{ui.placeHere}</button>
                <button type="button" class="back-btn">{ui.back}</button>
              </div>
              <dl class="anat">
                <dt>{ui.origin}</dt><dd>{tx(m.origin)}</dd>
                <dt>{ui.insertion}</dt><dd>{tx(m.insertion)}</dd>
                <dt>{ui.nerve}</dt><dd>{tx(m.nerve)}</dd>
                <dt>{ui.action}</dt><dd>{tx(m.action)}</dd>
              </dl>
              {m.why && <><h3>{ui.why}</h3><p>{tx(m.why)}</p></>}
              {m.cmd && <><h3>{ui.cmd}</h3><p>{tx(m.cmd)}</p></>}
              {m.xt && <><h3>{ui.xt}</h3><p>{tx(m.xt)}</p></>}
              {m.effort && <><h3>{ui.effort}</h3><p><span class={`eff eff-${m.effort.level}`}>{tx(D.effort.levels[m.effort.level])}</span> {tx(m.effort.text)}</p></>}
              <p class="area-line"></p>
            </article>
          ))}
          {Object.entries(D.bones).map(([k, b]: [string, any]) => (
            <article class="card-x card-m" data-card={`bone:${k}`} hidden>
              <p class="role-badge rb-bone">{lang === 'uk' ? 'Кістка або сполучнотканинна структура' : 'Bone or connective tissue'}</p>
              <h2 class="card-h">{tx(b.name)}</h2>
              <p class="latin">{b.latin}</p>
              <p>{tx(b.note)}</p>
              <button type="button" class="back-btn">{ui.back}</button>
            </article>
          ))}
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  import { initMyoMap } from '../scripts/myomap-client';
  initMyoMap();
</script>

<style is:global>
  body.bare { overflow: hidden; }
  @media (max-height: 520px), (max-width: 340px) { body.bare { overflow: auto; } }
</style>

<style>
  [hidden] { display: none !important; }
  .app { height: 100vh; height: 100dvh; min-height: 520px; display: grid; grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto minmax(0, 1fr); background: var(--bg); overflow: hidden; }

  /* app bar */
  .appbar { display: flex; align-items: center; gap: 12px; min-height: 52px; padding: 6px 16px; background: var(--graphite-900); color: var(--on-dark); }
  .brand { display: inline-flex; }
  .back { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 10px; border-radius: 8px; color: var(--on-dark-2); font-size: 14px; text-decoration: none; white-space: nowrap; }
  .back:hover { color: #fff; background: rgba(255, 255, 255, 0.07); }
  .app-title { margin: 0 0 0 4px; font: 600 17px/1.2 var(--font-serif); color: #fff; white-space: nowrap; }
  .ver { margin-left: 6px; padding: 1px 6px; border: 1px solid var(--dark-line); border-radius: 5px; font: 500 11px var(--font-mono); color: var(--on-dark-2); vertical-align: 2px; }
  .notice { margin: 0 0 0 auto; font-size: 12.5px; color: var(--on-dark-2); text-align: right; }
  .notice a { color: var(--on-dark-accent); }
  .lang-sw { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 36px; padding: 0 10px; border: 1px solid var(--dark-line); border-radius: 8px; color: var(--on-dark); font: 500 12.5px var(--font-mono); text-decoration: none; }
  .lang-sw:hover { border-color: var(--on-dark-accent); }

  /* toolbar */
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; padding: 8px 16px; background: var(--surface); border-bottom: 1px solid var(--line); }
  .ctl-label { font: 500 11px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .seg { display: flex; flex-wrap: nowrap; gap: 2px; padding: 3px; background: var(--chip); border-radius: 9px; flex: none; }
  .seg-btn { min-height: 34px; padding: 5px 10px; border: 0; border-radius: 6px; background: transparent; color: var(--text-2); font: 500 13px var(--font-sans); cursor: pointer; white-space: nowrap; }
  .seg-btn:hover { color: var(--ink); }
  .seg-btn[aria-pressed='true'] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 2px rgba(22, 27, 34, 0.14); }
  .seg-btn:focus-visible, .chip-btn:focus-visible, .pal-item:focus-visible, .sheet-handle:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .vbtn { display: none; }
  .mm[data-level='ph'] .vbtn[data-lv='ph'], .mm[data-level='tr'] .vbtn[data-lv='tr'], .mm[data-level='th'] .vbtn[data-lv='th'], .mm[data-level='sd'] .vbtn[data-lv='sd'] { display: inline-block; }
  .seclevels { display: none; flex-wrap: nowrap; gap: 6px; flex: none; }
  .mm.is-sec .seclevels { display: flex; }
  .chip-btn { display: none; min-height: 32px; padding: 4px 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); font: 500 13px var(--font-sans); color: var(--text-2); cursor: pointer; white-space: nowrap; }
  .mm[data-level='ph'] .chip-btn[data-lv='ph'], .mm[data-level='tr'] .chip-btn[data-lv='tr'], .mm[data-level='th'] .chip-btn[data-lv='th'] { display: inline-block; }
  .chip-btn[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); background: var(--accent-soft); }

  /* work area */
  .work { min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) minmax(330px, 400px); }
  .fig { position: relative; margin: 0; min-height: 0; display: flex; flex-direction: column; padding: 6px 12px 8px; background-color: var(--bg); background-image: linear-gradient(rgba(39, 86, 184, 0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(39, 86, 184, 0.05) 1px, transparent 1px); background-size: 24px 24px; }
  .stage :global(.scalebar path), .stage .scalebar path { fill: none; stroke: #3b4452; stroke-width: 1.6; }
  .stage .scalebar text { font: 600 10px var(--font-mono); fill: #3b4452; text-anchor: middle; }
  .stage-area { position: relative; flex: 1; min-height: 0; }
  .stage-wrap { position: absolute; inset: 0; display: flex; flex-direction: column; }
  .orient { display: flex; justify-content: space-between; gap: 8px; font: 500 11.5px var(--font-mono); color: var(--muted); padding: 2px 4px 4px; }
