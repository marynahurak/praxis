---
interface Props {
  size?: number;
}
const { size = 32 } = Astro.props;
const icon = Math.round(size * 0.62);
---

<span class="logo" style={`width:${size}px;height:${size}px;border-radius:${Math.round(size * 0.22)}px`} aria-hidden="true">
  <svg width={icon} height={icon} viewBox="0 0 20 20" fill="none">
    <path d="M3 17.5 H17" stroke="#A9B0BB" stroke-width="1.5" stroke-linecap="round"></path>
    <path d="M7 17 L13.5 5" stroke="#8FB0FF" stroke-width="2" stroke-linecap="round"></path>
    <path d="M9.6 5.7 L13.5 5 L14.7 8.7" stroke="#8FB0FF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</span>

<style>
  .logo {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--ink);
  }
</style>
