---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { SITE, t, type Lang } from '../config';
import { localePath } from '../utils';

interface Props {
  lang: Lang;
  altLangHref?: string;
}
const { lang, altLangHref } = Astro.props;
const s = t[lang];
const path = Astro.url.pathname;
const ukHref = lang === 'uk' ? path : (altLangHref ?? localePath('uk'));
const enHref = lang === 'en' ? path : (altLangHref ?? localePath('en'));
const nav = [
  { href: localePath(lang, 'library/'), label: s.nav.library },
  { href: `${localePath(lang)}#sections`, label: s.nav.sections },
  { href: `${localePath(lang, 'about/')}#evidence`, label: s.nav.method },
  { href: localePath(lang, 'about/'), label: s.nav.about },
];
---

<header class="site-header">
  <div class="container bar">
    <a href={localePath(lang)} class="brand" aria-label={s.homeLabel}>
      <Logo size={32} />
      <span>Praxis</span>
    </a>
    <nav aria-label={s.nav.label} class="nav">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="tools">
      <div class="lang" role="group" aria-label={s.langLabel}>
        <a href={ukHref} hreflang="uk" lang="uk" aria-current={lang === 'uk' ? 'true' : undefined}>УКР</a>
        <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>ENG</a>
      </div>
      <a class="icon-btn" href={localePath(lang, 'search/')} aria-label={s.searchLabel}>
        <Icon name="search" />
      </a>
      {
        SITE.telegramUrl && (
          <a class="btn btn-primary btn-sm tg" href={SITE.telegramUrl} target="_blank" rel="noopener">
            <Icon name="telegram" size={16} />
            <span>Telegram</span>
          </a>
        )
      }
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--graphite-900);
    border-bottom: 1px solid #0d1116;
    color: var(--on-dark);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 28px;
    padding-block: 12px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 23px;
    font-weight: 600;
    letter-spacing: 0.005em;
  }
  .brand:hover {
    color: #fff;
  }
  .brand :global(.logo) {
    background: var(--graphite-800);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  .nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 26px;
    font-size: 15px;
    font-weight: 500;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--on-dark-2);
    text-decoration: none;
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: #fff;
  }
  .nav a[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--on-dark-accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .lang {
    display: flex;
    border: 1px solid var(--dark-line);
    border-radius: 8px;
    overflow: hidden;
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 52px;
    min-height: 42px;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--on-dark-2);
    text-decoration: none;
  }
  .lang a:hover {
    color: #fff;
  }
  .lang a[aria-current='true'] {
    background: var(--on-dark);
    color: var(--graphite-900);
  }
  .icon-btn {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--dark-line);
    border-radius: 8px;
    color: var(--on-dark);
  }
  .icon-btn:hover {
    border-color: var(--on-dark-2);
    color: #fff;
  }
  .site-header :focus-visible {
    outline-color: var(--on-dark-accent);
  }
  @media (max-width: 760px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 4px 12px;
    }
    .nav {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: 0 18px;
      font-size: 14px;
      overflow-x: auto;
      flex-wrap: nowrap;
      white-space: nowrap;
      scrollbar-width: none;
    }
    .tg span {
      display: none;
    }
    .tg {
      width: 44px;
      padding: 0;
    }
  }
</style>
