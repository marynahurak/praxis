---
import Logo from './Logo.astro';
import { SECTIONS, SECTION_KEYS, SITE, t, type Lang } from '../config';
import { localePath } from '../utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const author = SITE.author[lang];
const year = new Date().getFullYear();
const years = year > SITE.since ? `${SITE.since}–${year}` : `${SITE.since}`;
const about = localePath(lang, 'about/');
---

<footer class="site-footer">
  <div class="container cols">
    <div class="about">
      <a href={localePath(lang)} class="brand" aria-label={s.homeLabel}>
        <Logo size={28} />
        <span>Praxis</span>
      </a>
      <p>{s.footer.about}</p>
      <p class="muted">{s.footer.founder}: {author.name}, {author.role.charAt(0).toLowerCase() + author.role.slice(1)}.</p>
    </div>
    <nav aria-labelledby="f-sections" class="col">
      <h2 id="f-sections">{s.footer.sections}</h2>
      {SECTION_KEYS.map((k) => <a href={localePath(lang, `sections/${k}/`)}>{SECTIONS[k][lang].title}</a>)}
      <a href={localePath(lang, 'library/')}>{s.nav.library}</a>
    </nav>
    <nav aria-labelledby="f-project" class="col">
      <h2 id="f-project">{s.footer.project}</h2>
      <a href={about}>{s.footer.links.about}</a>
      <a href={`${about}#policy`}>{s.footer.links.policy}</a>
      <a href={`${about}#evidence`}>{s.footer.links.evidence}</a>
      <a href={`${about}#ethics`}>{s.footer.links.ethics}</a>
      <a href={`${about}#license`}>{s.footer.links.license}</a>
    </nav>
    <nav aria-labelledby="f-links" class="col">
      <h2 id="f-links">{lang === 'uk' ? 'Посилання' : 'Links'}</h2>
      {SITE.telegramUrl && <a href={SITE.telegramUrl} rel="noopener">Telegram</a>}
      {SITE.linkedinUrl && <a href={SITE.linkedinUrl} rel="noopener">LinkedIn</a>}
      {SITE.instagramUrl && <a href={SITE.instagramUrl} rel="noopener">Instagram</a>}
      <a href={SITE.repoUrl} rel="noopener">{s.footer.links.code}</a>
    </nav>
  </div>
  <div class="container legal">
    <p>{s.footer.disclaimer} {s.footer.license} © {years} Praxis</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--graphite-900);
    color: var(--on-dark);
  }
  .cols {
    display: flex;
    flex-wrap: wrap;
    gap: 32px 48px;
    padding-block: 52px 28px;
  }
  .about {
    flex: 2 1 320px;
    min-width: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #fff;
    text-decoration: none;
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
  }
  .brand :global(.logo) {
    background: var(--graphite-800);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14);
  }
  .about p {
    margin: 12px 0 0;
    max-width: 460px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--on-dark-2);
  }
  .about .muted {
    color: #a3adbb;
  }
  .col {
    flex: 1 1 160px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .col h2 {
    margin: 0 0 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #a3adbb;
  }
  .col a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: 14px;
    color: var(--on-dark);
    text-decoration: none;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .legal p {
    margin: 0;
    padding: 20px 0 40px;
    border-top: 1px solid var(--dark-line);
    font-size: 13px;
    line-height: 1.6;
    color: #a3adbb;
  }
  .site-footer :focus-visible {
    outline-color: var(--on-dark-accent);
  }
</style>
