---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, t, type Lang } from '../config';
import { localePath, url } from '../utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altLangHref?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Без шапки й підвалу сайту — для повноекранних інструментів. */
  bare?: boolean;
}

const { lang, title, description, altLangHref, ogType = 'website', noindex = false, bare = false } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${s.siteTitle}`;
const desc = description ?? s.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = lang === 'uk' ? 'en' : 'uk';
const altHref = altLangHref ?? localePath(other);
const altAbs = new URL(altHref, Astro.site);
const ukAbs = lang === 'uk' ? canonical : altAbs;
const enAbs = lang === 'en' ? canonical : altAbs;
const ogImage = new URL(url(`og-${lang}.png?v=2`), Astro.site);
// Версія іконок: змініть число після оновлення значка, щоб браузери не показували старий з кешу.
const ICON_V = '?v=2';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={ukAbs} />
    <link rel="alternate" hreflang="en" href={enAbs} />
    <link rel="alternate" hreflang="x-default" href={ukAbs} />
    <link rel="icon" href={url('favicon.ico') + ICON_V} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg') + ICON_V} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png') + ICON_V} />
    <link rel="manifest" href={url('site.webmanifest') + ICON_V} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#161B22" />
    <meta name="author" content={SITE.author[lang].name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_GB'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${s.siteTitle}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body class={bare ? 'bare' : undefined}>
    <a class="skip-link" href="#main">{s.skip}</a>
    {!bare && <Header lang={lang} altLangHref={altLangHref} />}
    <main id="main">
      <slot />
    </main>
    {!bare && <Footer lang={lang} />}
  </body>
</html>
