---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/source-serif-4/400.css';
import '@fontsource/source-serif-4/400-italic.css';
import '@fontsource/source-serif-4/600.css';
import '@fontsource/source-serif-4/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, t, type Lang } from '../config';
import { localePath, url } from '../utils';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  altLangHref?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, title, description, altLangHref, ogType = 'website', noindex = false } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${s.siteTitle}`;
const desc = description ?? s.siteDescription;
const canonical = new URL(Astro.url.pathname, Astro.site);
const other = lang === 'uk' ? 'en' : 'uk';
const altHref = altLangHref ?? localePath(other);
const altAbs = new URL(altHref, Astro.site);
const ukAbs = lang === 'uk' ? canonical : altAbs;
const enAbs = lang === 'en' ? canonical : altAbs;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="uk" href={ukAbs} />
    <link rel="alternate" hreflang="en" href={enAbs} />
    <link rel="alternate" hreflang="x-default" href={ukAbs} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta name="theme-color" content="#1C2026" />
    <meta name="author" content={SITE.author[lang].name} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title ?? fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'uk' ? 'uk_UA' : 'en_GB'} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} altLangHref={altLangHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
